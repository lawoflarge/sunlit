    "ar.sweep.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim the centre of the frame at the top of whatever blocks your view, then hold Sweep and turn on the spot. The sky is divided into thirty six sectors of ten degrees and each one fills as you reach it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildmitte auf die Oberkante dessen richten, was die Sicht versperrt, dann Aufnehmen halten und sich auf der Stelle drehen. Der Himmel ist in sechsunddreißig Sektoren zu zehn Grad geteilt, und jeder füllt sich, sobald er erreicht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez avec le centre du cadre le sommet de ce qui bloque votre vue, puis maintenez Balayer et tournez sur place. Le ciel est divisé en trente-six secteurs de dix degrés, et chacun se remplit quand vous l’atteignez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il centro dell'inquadratura sulla cima di ciò che ti blocca la vista, poi tieni premuto il pulsante di scansione e gira su te stesso. Il cielo è diviso in trentasei settori da dieci gradi e ognuno si riempie quando lo raggiungi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro del encuadre a lo alto de aquello que te tape la vista, mantén pulsado Barrer y gira sobre ti mismo. El cielo se divide en treinta y seis sectores de diez grados y cada uno se rellena al llegar a él."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro del cuadro a lo más alto de lo que bloquea tu vista, luego mantén presionado el botón de barrido y gira sobre tu eje. El cielo se divide en treinta y seis sectores de diez grados y cada uno se llena al alcanzarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt het midden van het beeld op de bovenkant van wat je zicht blokkeert, houd dan de scanknop vast en draai op je plek rond. De hemel is verdeeld in zesendertig sectoren van tien graden en elke sector vult zich zodra je hem bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyceluj środek kadru w szczyt tego, co zasłania widok, potem przytrzymaj przycisk skanowania i obracaj się w miejscu. Niebo dzieli się na trzydzieści sześć sektorów po dziesięć stopni, a każdy wypełnia się, gdy do niego dotrzesz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視界をさえぎるものの上端にフレームの中心を合わせ、「走査」を押したままその場で回ります。空は10度ごとの36セクターに分かれ、到達したセクターから順に埋まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o centro do quadro para o topo do que bloqueia a sua vista, segure o botão de varredura e gire no lugar. O céu é dividido em trinta e seis setores de dez graus, e cada um se preenche quando você chega nele."
          }
        }
      }
    },
    "ar.sweep.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweeping your skyline is part of Sunlit Pro. It gives you the sunrise and sunset your own surroundings actually produce, and the periods when the sun is up but behind them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eigene Horizontprofil aufzunehmen gehört zu Sunlit Pro. Es liefert Sonnenaufgang und Sonnenuntergang so, wie die eigene Umgebung sie tatsächlich ergibt, und die Zeiträume, in denen die Sonne über dem Horizont, aber dahinter steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayer votre ligne d’horizon fait partie de Sunlit Pro. Vous obtenez le lever et le coucher du Soleil que produit vraiment votre environnement, ainsi que les périodes où le Soleil est levé mais caché derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansionare il tuo profilo fa parte di Sunlit Pro. Ti dà l'alba e il tramonto che l'ambiente intorno a te produce davvero, e i periodi in cui il Sole è alto ma nascosto dietro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrer tu perfil forma parte de Sunlit Pro. Te da la salida y la puesta del sol que producen realmente tus alrededores, y los periodos en que el sol está alto pero detrás de ellos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrer tu perfil del horizonte es parte de Sunlit Pro. Te da la salida y la puesta del sol que produce tu propio entorno, y los periodos en que el sol está arriba pero detrás de él."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je horizonprofiel scannen hoort bij Sunlit Pro. Het geeft je de zonsopgang en zonsondergang die je eigen omgeving werkelijk oplevert, en de perioden waarin de zon op is maar erachter zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie własnej linii horyzontu jest częścią Sunlit Pro. Daje wschód i zachód Słońca, jakie naprawdę wypadają w twoim otoczeniu, oraz okresy, gdy Słońce jest nad horyzontem, ale za przeszkodą."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "稜線の走査は Sunlit Pro の機能です。周囲が実際に生む日の出と日の入り、そして太陽は出ているのにその裏にある時間帯が分かります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Varrer o seu perfil faz parte do Sunlit Pro. Isso dá o nascer e o pôr do sol que o seu próprio entorno realmente produz, e os períodos em que o sol está no céu mas atrás dele."
          }
        }
      }
    },
