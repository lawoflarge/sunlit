    "data.terrain.notMeasured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No skyline has been swept for this place yet. Sweep one in the AR view and this table fills in with the times your own surroundings block the sun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Ort wurde noch kein Horizontprofil aufgenommen. Eines in der AR-Ansicht aufnehmen, dann füllt sich diese Tabelle mit den Zeiten, in denen die eigene Umgebung die Sonne verdeckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ligne d’horizon n’a encore été balayée pour ce lieu. Balayez-en une dans la vue AR et ce tableau se remplira avec les moments où votre environnement cache le Soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo luogo non è ancora stato scansionato nessun profilo. Scansionane uno nella vista AR e questa tabella si riempie con gli orari in cui l'ambiente intorno a te nasconde il Sole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha barrido ningún perfil para este lugar. Barre uno en la vista AR y esta tabla se rellenará con las horas en que tus propios alrededores tapan el sol."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha barrido ningún perfil del horizonte para este lugar. Barre uno en la vista AR y esta tabla se llena con las horas en que tu propio entorno bloquea el sol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze plaats is nog geen horizonprofiel gescand. Scan er een in de AR-weergave en deze tabel vult zich met de tijden waarop je eigen omgeving de zon blokkeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego miejsca nie zeskanowano jeszcze linii horyzontu. Zeskanuj ją w widoku AR, a ta tabela wypełni się godzinami, w których twoje otoczenie zasłania Słońce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地点の稜線はまだ走査されていません。AR ビューで走査すると、周囲が太陽をさえぎる時刻でこの表が埋まります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum perfil foi varrido para este local ainda. Varra um na visualização AR e esta tabela se preenche com os horários em que o seu próprio entorno bloqueia o sol."
          }
        }
      }
    },
