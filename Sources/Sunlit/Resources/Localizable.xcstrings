    "ar.moon.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon is part of Sunlit Pro: its path over your view, its phase, and its rise and set with parallax."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond gehört zu Sunlit Pro: seine Bahn über der eigenen Sicht, seine Phase sowie Aufgang und Untergang mit Parallaxe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune fait partie de Sunlit Pro : sa course sur votre vue, sa phase, son lever et son coucher avec la parallaxe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Luna fa parte di Sunlit Pro: il suo percorso sulla tua visuale, la sua fase e il suo sorgere e tramontare con la parallasse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna forma parte de Sunlit Pro: su trayectoria sobre tu vista, su fase y su salida y su puesta con paralaje."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna es parte de Sunlit Pro: su trayectoria sobre tu vista, su fase, y su salida y su puesta con paralaje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maan hoort bij Sunlit Pro: de baan over je beeld, de fase, en opkomst en ondergang met parallax."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Księżyc jest częścią Sunlit Pro: jego droga na obrazie z aparatu, faza oraz wschód i zachód z paralaksą."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月は Sunlit Pro の機能です。視界に重ねた軌道、月相、視差を含む月の出と月の入りが加わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua faz parte do Sunlit Pro: sua trajetória sobre a sua vista, sua fase e seu nascer e pôr com paralaxe."
          }
        }
      }
    },
    "ar.moon.lockedSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever. Another day or another place is part of Sunlit Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute am aktuellen Standort ist für immer gratis. Ein anderer Tag oder ein anderer Ort gehört zu Sunlit Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, à votre position actuelle, est gratuit pour toujours. Un autre jour ou un autre lieu fait partie de Sunlit Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nella tua posizione attuale è gratis per sempre. Un altro giorno o un altro luogo fa parte di Sunlit Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre. Otro día u otro lugar forma parte de Sunlit Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre. Otro día u otro lugar es parte de Sunlit Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je huidige locatie is voor altijd gratis. Een andere dag of een andere plaats hoort bij Sunlit Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dzień w bieżącej lokalizacji jest darmowy na zawsze. Inny dzień lub inne miejsce są częścią Sunlit Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の今日は永久に無料です。別の日や別の地点は Sunlit Pro の機能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na sua localização atual é grátis para sempre. Outro dia ou outro local faz parte do Sunlit Pro."
          }
        }
      }
    },
    "ar.optics.assumed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is reporting its lens here, so the overlay is drawn at an assumed field of view."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier meldet keine Kamera ihr Objektiv, die Überlagerung wird daher mit einem angenommenen Bildwinkel gezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil photo ne communique son objectif ici : la superposition est donc tracée avec un champ de vision supposé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui nessuna fotocamera comunica il suo obiettivo, quindi la sovrapposizione è disegnata con un campo visivo presunto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ninguna cámara informa de su objetivo, así que la superposición se dibuja con un campo de visión supuesto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cámara reporta aquí su lente, así que la superposición se dibuja con un campo de visión supuesto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen camera meldt hier zijn lens, dus de overlay wordt op een aangenomen beeldhoek getekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden aparat nie podaje tu swojego obiektywu, więc nakładka rysowana jest dla przyjętego pola widzenia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではレンズ情報を返すカメラがないため、オーバーレイは想定の画角で描かれます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma câmera está informando sua lente aqui, então a sobreposição é desenhada com um campo de visão presumido."
          }
        }
      }
    },
    "ar.selection.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever. This screen is showing another day or another place, so the figures and the overlay are dimmed until Sunlit Pro is unlocked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute am aktuellen Standort ist für immer gratis. Dieser Bildschirm zeigt einen anderen Tag oder einen anderen Ort, deshalb sind die Werte und die Überlagerung gedimmt, bis Sunlit Pro freigeschaltet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, à votre position actuelle, est gratuit pour toujours. Cet écran affiche un autre jour ou un autre lieu : les valeurs et la superposition restent estompées tant que Sunlit Pro n’est pas déverrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nella tua posizione attuale è gratis per sempre. Questa schermata mostra un altro giorno o un altro luogo, quindi i valori e la sovrapposizione restano attenuati finché non sblocchi Sunlit Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre. Esta pantalla muestra otro día u otro lugar, así que las cifras y la superposición se atenúan hasta que desbloquees Sunlit Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre. Esta pantalla muestra otro día u otro lugar, así que las cifras y la superposición se atenúan hasta desbloquear Sunlit Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je huidige locatie is voor altijd gratis. Dit scherm toont een andere dag of een andere plaats, dus de cijfers en de overlay blijven gedempt tot Sunlit Pro is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dzień w bieżącej lokalizacji jest darmowy na zawsze. Ten ekran pokazuje inny dzień lub inne miejsce, więc wartości i nakładka są przygaszone do czasu odblokowania Sunlit Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の今日は永久に無料です。この画面は別の日または別の地点を表示しているため、Sunlit Pro を解除するまで数値とオーバーレイは淡く表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na sua localização atual é grátis para sempre. Esta tela está mostrando outro dia ou outro local, então os valores e a sobreposição ficam esmaecidos até o Sunlit Pro ser desbloqueado."
          }
        }
      }
    },
    "ar.skyline.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dashed line is the skyline swept at this place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gestrichelte Linie ist das an diesem Ort aufgenommene Horizontprofil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tracé pointillé est la ligne d’horizon balayée pour ce lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La linea tratteggiata è il profilo scansionato in questo luogo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea discontinua es el perfil barrido en este lugar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea punteada es el perfil del horizonte barrido en este lugar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stippellijn is het horizonprofiel dat op deze plaats is gescand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linia przerywana to linia horyzontu zeskanowana w tym miejscu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破線は、この地点で走査した稜線です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha tracejada é o perfil varrido neste local."
          }
        }
      }
    },
