    "settings.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every figure in Sunlit is computed on this device. Nothing about you is collected and nothing is sent. Every calculation works in aeroplane mode; only Apple's map tiles and the time zone of a newly dropped pin need a connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wert in Sunlit wird auf diesem Gerät berechnet. Nichts über die eigene Person wird erfasst und nichts gesendet. Jede Berechnung funktioniert im Flugmodus, nur die Kartenkacheln von Apple und die Zeitzone einer neu gesetzten Markierung brauchen eine Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque valeur de Sunlit est calculée sur cet appareil. Rien vous concernant n’est collecté et rien n’est envoyé. Tous les calculs fonctionnent en mode avion ; seules les tuiles de carte d’Apple et le fuseau horaire d’un repère tout juste déposé demandent une connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni valore di Sunlit è calcolato su questo dispositivo. Non viene raccolto né inviato nulla che ti riguardi. Ogni calcolo funziona in modalità aereo: solo le tessere della mappa di Apple e il fuso orario di un segnaposto appena messo hanno bisogno di una connessione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cifras de Sunlit se calculan en este dispositivo. No se recopila nada sobre ti y no se envía nada. Todos los cálculos funcionan en modo avión; solo los mosaicos del mapa de Apple y la zona horaria de un marcador recién soltado necesitan conexión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cifra de Sunlit se calcula en este dispositivo. No se recolecta nada sobre ti y no se envía nada. Todos los cálculos funcionan en modo avión; solo las teselas del mapa de Apple y la zona horaria de un pin recién colocado necesitan conexión."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk cijfer in Sunlit wordt op dit toestel berekend. Er wordt niets over jou verzameld en niets verstuurd. Elke berekening werkt in vliegtuigmodus; alleen de kaarttegels van Apple en de tijdzone van een pas geplaatste speld hebben een verbinding nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda wartość w Sunlit jest obliczana na tym urządzeniu. Nic o tobie nie jest zbierane i nic nie jest wysyłane. Wszystkie obliczenia działają w trybie samolotowym, a połączenia wymagają tylko kafelki mapy od Apple i strefa czasowa nowo postawionej pinezki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit のすべての数値はこの端末上で計算されます。あなたに関する情報は収集も送信もされません。計算はすべて機内モードでも動きます。接続が必要なのは Apple の地図タイルと、新しく置いたピンのタイムゾーンだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os valores do Sunlit são calculados neste dispositivo. Nada sobre você é coletado e nada é enviado. Todo cálculo funciona em modo avião; só os blocos de mapa da Apple e o fuso horário de um marcador recém-solto precisam de conexão."
          }
        }
      }
    },
