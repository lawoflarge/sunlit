    "data.twilight.nautical.neverDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not sink twelve degrees below the horizon on this date, so nautical twilight lasts all night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne sinkt an diesem Tag nicht zwölf Grad unter den Horizont, die nautische Dämmerung dauert also die ganze Nacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne descend pas à douze degrés sous l’horizon à cette date : le crépuscule nautique dure donc toute la nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data il Sole non scende dodici gradi sotto l'orizzonte, quindi il crepuscolo nautico dura tutta la notte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja doce grados por debajo del horizonte en esta fecha, así que el crepúsculo náutico dura toda la noche."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja doce grados bajo el horizonte en esta fecha, así que el crepúsculo náutico dura toda la noche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon zakt op deze datum niet twaalf graden onder de horizon, dus de nautische schemering duurt de hele nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej dacie Słońce nie schodzi dwanaście stopni pod horyzont, więc zmierzch żeglarski trwa całą noc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付、太陽は地平線より12度下まで沈まないため、航海薄明が一晩中続きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol não desce doze graus abaixo do horizonte nesta data, então o crepúsculo náutico dura a noite toda."
          }
        }
      }
    },
