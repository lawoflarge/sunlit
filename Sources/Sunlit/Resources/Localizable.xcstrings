    "ar.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off, so the paths are drawn over the sky colour instead of over your view. Everything else on this screen still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aus, die Bahnen werden daher über der Himmelsfarbe statt über der eigenen Sicht gezeichnet. Alles andere auf diesem Bildschirm funktioniert weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est désactivé : les trajectoires sont donc tracées sur la couleur du ciel et non sur votre vue. Tout le reste de cet écran fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato, quindi i percorsi sono disegnati sul colore del cielo anziché sulla tua visuale. Tutto il resto di questa schermata funziona lo stesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado, así que las trayectorias se dibujan sobre el color del cielo en lugar de sobre tu vista. Todo lo demás de esta pantalla sigue funcionando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado, así que las trayectorias se dibujan sobre el color del cielo en vez de sobre tu vista. Todo lo demás en esta pantalla sigue funcionando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang staat uit, dus de banen worden over de hemelkleur getekend in plaats van over je beeld. Al het andere op dit scherm werkt gewoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest wyłączony, więc drogi rysowane są na kolorze nieba zamiast na obrazie z aparatu. Reszta tego ekranu działa normalnie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフのため、軌道は実際の視界ではなく空の色の上に描かれます。この画面の他の機能はすべて動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado, então as trajetórias são desenhadas sobre a cor do céu em vez de sobre a sua vista. Todo o resto desta tela continua funcionando."
          }
        }
      }
    },
    "ar.camera.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is restricted on this device, so the paths are drawn over the sky colour instead. Everything else on this screen still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist auf diesem Gerät eingeschränkt, die Bahnen werden daher über der Himmelsfarbe gezeichnet. Alles andere auf diesem Bildschirm funktioniert weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo est restreint sur cet appareil : les trajectoires sont donc tracées sur la couleur du ciel. Tout le reste de cet écran fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera è soggetta a restrizioni su questo dispositivo, quindi i percorsi sono disegnati sul colore del cielo. Tutto il resto di questa schermata funziona lo stesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara está restringida en este dispositivo, así que las trayectorias se dibujan sobre el color del cielo. Todo lo demás de esta pantalla sigue funcionando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara está restringida en este dispositivo, así que las trayectorias se dibujan sobre el color del cielo. Todo lo demás en esta pantalla sigue funcionando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is op dit toestel beperkt, dus de banen worden in plaats daarvan over de hemelkleur getekend. Al het andere op dit scherm werkt gewoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat jest na tym urządzeniu ograniczony, więc drogi rysowane są na kolorze nieba. Reszta tego ekranu działa normalnie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではカメラが制限されているため、軌道は空の色の上に描かれます。この画面の他の機能はすべて動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera está restrita neste dispositivo, então as trajetórias são desenhadas sobre a cor do céu. Todo o resto desta tela continua funcionando."
          }
        }
      }
    },
