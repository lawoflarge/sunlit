    "data.sun.polarDay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays above the horizon all day here, so there is no sunrise and no sunset on this date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag über dem Horizont, es gibt an diesem Tag also keinen Sonnenaufgang und keinen Sonnenuntergang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste au-dessus de l’horizon toute la journée ici : il n’y a donc ni lever ni coucher à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta sopra l'orizzonte per tutto il giorno, quindi in questa data non c'è né alba né tramonto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene sobre el horizonte todo el día, así que no hay salida ni puesta de sol en esta fecha."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene sobre el horizonte todo el día aquí, así que no hay salida ni puesta del sol en esta fecha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag boven de horizon, dus er is op deze datum geen zonsopgang en geen zonsondergang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez całą dobę nad horyzontem, więc w tej dacie nie ma wschodu ani zachodu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽がこの日ずっと地平線より上にあるため、この日付に日の出も日の入りもありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica acima do horizonte o dia todo aqui, então não há nascer nem pôr do sol nesta data."
          }
        }
      }
    },
    "data.sun.polarNight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays below the horizon all day here, so there is no sunrise and no sunset on this date."
          }
