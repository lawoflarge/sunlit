            "state": "translated",
            "value": "Qui non c'è una fotocamera, quindi i percorsi sono disegnati sul colore del cielo. Tutto il resto di questa schermata funziona lo stesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay cámara, así que las trayectorias se dibujan sobre el color del cielo. Todo lo demás de esta pantalla sigue funcionando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay cámara, así que las trayectorias se dibujan sobre el color del cielo. Todo lo demás en esta pantalla sigue funcionando."
          }
        },
        "nl": {
