    "data.eclipse.lowSun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun is close to the horizon then, so you will need a clear view in that direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne steht dann nahe am Horizont, in dieser Richtung braucht es also freie Sicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil sera alors bas sur l’horizon : il vous faudra une vue dégagée dans cette direction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quel momento il Sole è basso sull'orizzonte, quindi ti servirà una vista libera in quella direzione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol está entonces cerca del horizonte, así que necesitarás una vista despejada en esa dirección."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol está cerca del horizonte entonces, así que necesitarás una vista despejada en esa dirección."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon staat dan dicht bij de horizon, dus je hebt vrij zicht in die richting nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest wtedy blisko horyzontu, więc potrzebny będzie odsłonięty widok w tym kierunku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのとき太陽は地平線に近いため、その方向の視界が開けている必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol está perto do horizonte nesse momento, então você vai precisar de vista livre nessa direção."
          }
        }
      }
    },
