    "credits.trueNorth.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AR view takes its direction from the device's true north reference frame, computed by iOS from the compass, the gyroscope and your position. Sunlit does not correct it further, and it shows the current uncertainty on screen instead of hiding it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die AR-Ansicht nimmt ihre Richtung aus dem geografischen Nordbezug des Geräts, den iOS aus Kompass, Gyroskop und Position berechnet. Sunlit korrigiert ihn nicht weiter und zeigt die aktuelle Unsicherheit auf dem Bildschirm, statt sie zu verbergen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vue AR prend son orientation dans le référentiel du nord géographique de l’appareil, calculé par iOS à partir de la boussole, du gyroscope et de votre position. Sunlit ne le corrige pas davantage et affiche à l’écran l’incertitude du moment plutôt que de la masquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista AR prende la direzione dal sistema di riferimento del nord geografico del dispositivo, calcolato da iOS a partire dalla bussola, dal giroscopio e dalla tua posizione. Sunlit non lo corregge ulteriormente e mostra sullo schermo l'incertezza attuale invece di nasconderla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista AR toma su dirección del sistema de referencia del norte geográfico del dispositivo, que iOS calcula a partir de la brújula, el giroscopio y tu posición. Sunlit no lo corrige más, y muestra en pantalla la incertidumbre actual en lugar de ocultarla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista AR toma su dirección del marco de referencia de norte verdadero del dispositivo, que iOS calcula con la brújula, el giroscopio y tu posición. Sunlit no lo corrige más, y muestra en pantalla la incertidumbre actual en vez de ocultarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AR-weergave neemt haar richting uit het referentiekader voor het ware noorden van het toestel, dat iOS berekent uit het kompas, de gyroscoop en je positie. Sunlit corrigeert dat niet verder en toont de huidige onzekerheid op het scherm in plaats van die te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widok AR bierze kierunek z układu odniesienia północy geograficznej urządzenia, wyliczanego przez iOS z kompasu, żyroskopu i twojej pozycji. Sunlit nie poprawia go dalej i pokazuje bieżącą niepewność na ekranie, zamiast ją ukrywać."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AR ビューの方位角は、iOS がコンパス、ジャイロスコープ、位置から求める端末の真北基準系から取ります。Sunlit はそれ以上の補正を加えず、現在の不確かさを隠さず画面に表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização AR tira a sua direção do referencial de norte verdadeiro do dispositivo, calculado pelo iOS a partir da bússola, do giroscópio e da sua posição. O Sunlit não faz nenhuma correção além dessa e mostra a incerteza atual na tela em vez de escondê-la."
          }
        }
      }
    },
