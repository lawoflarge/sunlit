    "data.footer.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every figure here is computed on this device from the selected place and date. Nothing on this screen needs a network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wert hier wird auf diesem Gerät aus dem gewählten Ort und Datum berechnet. Nichts auf diesem Bildschirm braucht ein Netz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque valeur ici est calculée sur cet appareil à partir du lieu et de la date sélectionnés. Rien sur cet écran n’a besoin d’un réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni valore qui è calcolato su questo dispositivo a partire dal luogo e dalla data selezionati. Niente in questa schermata ha bisogno della rete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las cifras de aquí se calculan en este dispositivo a partir del lugar y la fecha seleccionados. Nada de esta pantalla necesita red."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cifra de aquí se calcula en este dispositivo a partir del lugar y la fecha seleccionados. Nada de esta pantalla necesita red."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk cijfer hier wordt op dit toestel berekend uit de gekozen plaats en datum. Niets op dit scherm heeft een netwerk nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda wartość tutaj jest obliczana na tym urządzeniu z wybranego miejsca i daty. Nic na tym ekranie nie potrzebuje sieci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここのすべての数値は、選択した地点と日付から端末上で計算されます。この画面にネットワークは不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os valores daqui são calculados neste dispositivo a partir do local e da data selecionados. Nada nesta tela precisa de rede."
          }
        }
      }
    },
