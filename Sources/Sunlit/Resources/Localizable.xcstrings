            "value": "geonames.org"
          }
        }
      }
    },
    "credits.irradiance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irradiance model"
          }
        }
      }
    },
    "credits.methods": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the positions are computed"
          }
        }
      }
    },
    "credits.methods.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every figure in Sunlit is computed on your device from published algorithms. No server is ever asked for a sun, moon or sky figure, and nothing about you is collected or sent. Two things do use the network, both of them Apple's and neither of them a calculation: the map tiles in the Map view, and the time zone of a pin you drop somewhere new."
          }
        }
      }
    },
    "credits.milkyWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Milky Way"
          }
        }
      }
    },
    "credits.models": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is modelled, not measured"
          }
        }
      }
    },
    "credits.models.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The UV index and the irradiance figures are clear sky models. They say what the sky would deliver with no cloud, no haze and no pollution, from your latitude, the date and the sun's height. They are not measurements, Sunlit has no sensor for either, and real weather can put them far off."
          }
        }
      }
    },
    "credits.moon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon"
          }
        }
      }
    },
    "credits.nutation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutation and obliquity"
          }
        }
      }
    },
    "credits.places": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places"
          }
        }
      }
    },
    "credits.places.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offline city list is the GeoNames cities15000 extract: every populated place above fifteen thousand people, with its coordinate, elevation and time zone. It is used under the Creative Commons Attribution 4.0 licence, and it is stored in the app so that search works with no network."
          }
        }
      }
    },
    "credits.refraction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refraction"
          }
        }
      }
    },
    "credits.sun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun"
          }
        }
      }
    },
    "credits.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data and methods"
          }
        }
      }
    },
    "credits.trueNorth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True north"
          }
        }
      }
    },
    "credits.trueNorth.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AR view takes its direction from the device's true north reference frame, computed by iOS from the compass, the gyroscope and your position. Sunlit does not correct it further, and it shows the current uncertainty on screen instead of hiding it."
          }
        }
      }
    },
    "credits.uv": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UV index model"
          }
        }
      }
    },
    "data.annual.belowHorizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the curve runs under the horizon line the sun does not rise at all on that date."
          }
        }
      }
    },
    "data.annual.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest the sun reaches on each date of the year at this place. The four light uprights are the equinoxes and the solstices. The heavier one is the date you have selected, which is a fifth upright on all but those four dates."
          }
        }
      }
    },
    "data.annual.decemberSolstice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "December solstice"
          }
        }
      }
    },
    "data.annual.juneSolstice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June solstice"
          }
        }
      }
    },
    "data.annual.marchEquinox": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March equinox"
          }
        }
      }
    },
    "data.annual.septemberEquinox": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "September equinox"
          }
        }
      }
    },
    "data.annual.spread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Range across the year"
          }
        }
      }
    },
    "data.annual.spreadCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference between the highest and the lowest the midday sun gets here. Outside the tropics it is about forty seven degrees, twice the tilt of the earth. Inside them it is less, because the noon sun passes overhead twice a year and turns back."
          }
        }
      }
    },
    "data.annual.thisDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date"
          }
        }
      }
    },
    "data.annual.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun across the year"
