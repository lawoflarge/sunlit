    "data.eclipse.alreadyUnderWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun rises here with the eclipse already in progress, so there is no first contact to see."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne geht hier auf, während die Finsternis schon läuft, es gibt also keinen ersten Kontakt zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil se lève ici alors que l’éclipse est déjà en cours : il n’y a donc pas de premier contact à voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole sorge con l'eclissi già in corso, quindi non c'è un primo contatto da vedere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol sale con el eclipse ya en curso, así que no hay primer contacto que ver."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol sale aquí con el eclipse ya en curso, así que no hay primer contacto que ver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon komt hier op terwijl de verduistering al bezig is, dus er is geen eerste contact te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce wschodzi tu, gdy zaćmienie już trwa, więc pierwszego kontaktu nie da się zobaczyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは食が始まった状態で太陽が昇るため、見られる食の始めはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol nasce aqui com o eclipse já em andamento, então não há primeiro contato para ver."
          }
        }
      }
    },
    "data.eclipse.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next solar eclipse visible from this place, and the next lunar eclipse wherever it falls, searched over the coming five years. A lunar eclipse happens at the same instant everywhere on Earth, so one is listed even when the moon is below the horizon here. All times are local to this place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste von diesem Ort aus sichtbare Sonnenfinsternis und die nächste Mondfinsternis, wo immer sie stattfindet, gesucht über die kommenden fünf Jahre. Eine Mondfinsternis läuft überall auf der Erde im selben Moment ab, deshalb wird auch dann eine aufgeführt, wenn der Mond hier unter dem Horizont steht. Alle Zeiten gelten in der Ortszeit dieses Ortes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine éclipse de Soleil visible depuis ce lieu, et la prochaine éclipse de Lune où qu’elle tombe, recherchées sur les cinq années à venir. Une éclipse de Lune se produit au même instant partout sur Terre : elle est donc indiquée même si la Lune est sous l’horizon ici. Toutes les heures sont locales à ce lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima eclissi solare visibile da questo luogo e la prossima eclissi lunare ovunque cada, cercate nei prossimi cinque anni. Un'eclissi lunare avviene nello stesso istante ovunque sulla Terra, quindi ne viene indicata una anche quando qui la Luna è sotto l'orizzonte. Tutti gli orari sono locali a questo luogo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo eclipse solar visible desde este lugar, y el próximo eclipse lunar caiga donde caiga, buscados en los próximos cinco años. Un eclipse lunar ocurre en el mismo instante en toda la Tierra, así que aparece en la lista aunque aquí la luna esté bajo el horizonte. Todas las horas son locales de este lugar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo eclipse solar visible desde este lugar, y el próximo eclipse lunar caiga donde caiga, buscados en los próximos cinco años. Un eclipse lunar ocurre en el mismo instante en toda la Tierra, así que se lista aunque la luna esté bajo el horizonte aquí. Todas las horas son locales de este lugar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerstvolgende zonsverduistering die vanaf deze plaats zichtbaar is, en de eerstvolgende maansverduistering waar die ook valt, gezocht over de komende vijf jaar. Een maansverduistering vindt overal op aarde op hetzelfde moment plaats, dus die staat er ook bij als de maan hier onder de horizon staat. Alle tijden zijn lokaal voor deze plaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbliższe zaćmienie Słońca widoczne z tego miejsca oraz najbliższe zaćmienie Księżyca, gdziekolwiek wypada, szukane w ciągu najbliższych pięciu lat. Zaćmienie Księżyca zachodzi w tej samej chwili na całej Ziemi, więc jest wypisane nawet wtedy, gdy Księżyc jest tu pod horyzontem. Wszystkie godziny są lokalne dla tego miejsca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地点から見える次の日食と、どこで起きるかを問わない次の月食を、今後5年について探索した結果です。月食は地球上のどこでも同じ瞬間に起こるため、ここで月が地平線より下にあっても掲載します。時刻はすべてこの地点の現地時刻です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo eclipse solar visível deste local e o próximo eclipse lunar onde quer que ele caia, procurados ao longo dos cinco anos que vêm. Um eclipse lunar acontece no mesmo instante em toda a Terra, então ele é listado mesmo quando a lua está abaixo do horizonte aqui. Todos os horários são locais deste lugar."
          }
        }
      }
    },
