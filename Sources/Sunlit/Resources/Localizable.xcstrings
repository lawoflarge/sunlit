    "store.result.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval. Sunlit unlocks by itself as soon as the purchase is approved, even if you close the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Freigabe. Sunlit schaltet sich von selbst frei, sobald der Kauf freigegeben ist, auch wenn die App geschlossen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Sunlit se déverrouille tout seul dès que l’achat est approuvé, même si vous fermez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Sunlit si sblocca da solo appena l'acquisto viene approvato, anche se chiudi l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la aprobación. Sunlit se desbloquea solo en cuanto se apruebe la compra, aunque cierres la app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Sunlit se desbloquea solo en cuanto se apruebe la compra, aunque cierres la app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op goedkeuring. Sunlit ontgrendelt zichzelf zodra de aankoop is goedgekeurd, ook als je de app sluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na zatwierdzenie. Sunlit odblokuje się sam, gdy tylko zakup zostanie zatwierdzony, nawet po zamknięciu aplikacji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。購入が承認され次第、アプリを閉じていても Sunlit は自動で解除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O Sunlit desbloqueia sozinho assim que a compra for aprovada, mesmo que você feche o app."
          }
        }
      }
    },
