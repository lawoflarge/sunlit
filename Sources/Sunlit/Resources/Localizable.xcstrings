    "paywall.capability.eclipses.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solar and lunar, with contact times, magnitude and obscuration as seen from where you are."
