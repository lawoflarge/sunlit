    "settings.horizon.gate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A skyline you have swept moves your sunrise and sunset to the times you actually see, and lists the periods the sun is up but behind something. Reading the table is free. Changing it is part of Sunlit Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aufgenommenes Horizontprofil verschiebt Sonnenaufgang und Sonnenuntergang auf die Zeiten, die tatsächlich zu sehen sind, und listet die Zeiträume, in denen die Sonne über dem Horizont, aber hinter etwas steht. Die Tabelle zu lesen ist gratis. Änderungen daran gehören zu Sunlit Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne d’horizon que vous avez balayée déplace votre lever et votre coucher aux heures que vous voyez vraiment, et liste les périodes où le Soleil est levé mais caché derrière quelque chose. Lire le tableau est gratuit. Le modifier fait partie de Sunlit Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo che hai scansionato sposta la tua alba e il tuo tramonto agli orari che vedi davvero, ed elenca i periodi in cui il Sole è alto ma dietro qualcosa. Leggere la tabella è gratis. Modificarla fa parte di Sunlit Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil que hayas barrido mueve tu salida y tu puesta de sol a las horas que ves realmente, y enumera los periodos en que el sol está alto pero detrás de algo. Leer la tabla es gratis. Cambiarla forma parte de Sunlit Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil del horizonte que hayas barrido mueve tu salida y tu puesta del sol a las horas que de verdad ves, y lista los periodos en que el sol está arriba pero detrás de algo. Leer la tabla es gratis. Cambiarla es parte de Sunlit Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een horizonprofiel dat je hebt gescand verschuift je zonsopgang en zonsondergang naar de tijden die je werkelijk ziet, en somt de perioden op waarin de zon op is maar achter iets zit. De tabel lezen is gratis. Hem wijzigen hoort bij Sunlit Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanowana linia horyzontu przesuwa wschód i zachód Słońca na godziny, które naprawdę widzisz, i wypisuje okresy, gdy Słońce jest nad horyzontem, ale za przeszkodą. Czytanie tabeli jest darmowe. Jej zmiana jest częścią Sunlit Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走査した稜線は、日の出と日の入りを実際に見える時刻に移し、太陽は出ているのに何かの裏にある時間帯を並べます。表を読むのは無料です。表を変更することは Sunlit Pro の機能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil varrido por você move o seu nascer e o seu pôr do sol para os horários que você realmente vê, e lista os períodos em que o sol está no céu mas atrás de alguma coisa. Ler a tabela é grátis. Alterá-la faz parte do Sunlit Pro."
          }
        }
      }
    },
