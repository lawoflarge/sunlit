    "settings.notifications.gate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event notifications are part of Sunlit Pro. They are computed on your device and nothing about your times or your place leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignismitteilungen gehören zu Sunlit Pro. Sie werden auf dem Gerät berechnet, und nichts über die Zeiten oder den Ort verlässt es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications d’événements font partie de Sunlit Pro. Elles sont calculées sur votre appareil et rien de vos heures ni de votre lieu n’en sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche degli eventi fanno parte di Sunlit Pro. Sono calcolate sul tuo dispositivo e non esce nulla che riguardi i tuoi orari o il tuo luogo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de eventos forman parte de Sunlit Pro. Se calculan en tu dispositivo y nada sobre tus horas ni sobre tu lugar sale de él."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de eventos son parte de Sunlit Pro. Se calculan en tu dispositivo y nada sobre tus horas ni sobre tu lugar sale de él."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebeurtenismeldingen horen bij Sunlit Pro. Ze worden op je toestel berekend en niets over je tijden of je plaats verlaat het toestel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia o zjawiskach są częścią Sunlit Pro. Są obliczane na twoim urządzeniu i nic o twoich godzinach ani miejscu go nie opuszcza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現象の通知は Sunlit Pro の機能です。端末上で計算され、あなたの時刻も地点も端末の外には出ません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações de eventos fazem parte do Sunlit Pro. Elas são calculadas no seu dispositivo e nada sobre os seus horários ou o seu local sai dele."
          }
        }
      }
    },
    "settings.notifications.horizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled for the next %lld days at %@, from the same figures the app shows. Open Sunlit now and then to extend them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplant für die nächsten %1$@ Tage an %2$@, aus denselben Werten, die die App zeigt. Sunlit ab und zu öffnen, damit sie weiterlaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmées pour les %1$@ prochains jours à %2$@, à partir des mêmes valeurs que celles affichées par l’app. Ouvrez Sunlit de temps en temps pour les prolonger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmate per i prossimi %1$@ giorni a %2$@, dagli stessi valori che l'app mostra. Apri Sunlit ogni tanto per estenderle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programados para los próximos %1$@ días en %2$@, a partir de las mismas cifras que muestra la app. Abre Sunlit de vez en cuando para ampliarlos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Programadas para los próximos %1$@ días en %2$@, con las mismas cifras que muestra la app. Abre Sunlit de vez en cuando para extenderlas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepland voor de komende %1$@ dagen in %2$@, uit dezelfde cijfers die de app toont. Open Sunlit af en toe om ze te verlengen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanowane na kolejne %1$@ dni w miejscu %2$@, z tych samych wartości, które pokazuje aplikacja. Otwieraj Sunlit od czasu do czasu, aby je przedłużyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後 %1$@ 日分を %2$@ で、アプリが示すのと同じ数値から予約しています。ときどき Sunlit を開くと先まで延びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agendadas para os próximos %1$@ dias em %2$@, a partir dos mesmos valores que o app mostra. Abra o Sunlit de vez em quando para estendê-las."
          }
        }
      }
    },
    "settings.notifications.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are switched off for Sunlit in the system settings, so nothing will arrive until they are switched back on. Everything else keeps working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Sunlit in den Systemeinstellungen ausgeschaltet, es kommt also nichts an, bis sie wieder eingeschaltet sind. Alles andere funktioniert weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Sunlit dans les réglages système : rien n’arrivera tant qu’elles ne seront pas réactivées. Tout le reste continue de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche per Sunlit sono disattivate nelle impostazioni di sistema, quindi non arriverà nulla finché non le riattivi. Tutto il resto continua a funzionare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Sunlit en los ajustes del sistema, así que no llegará nada hasta que se vuelvan a activar. Todo lo demás sigue funcionando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Sunlit en la configuración del sistema, así que no llegará nada hasta que se activen de nuevo. Todo lo demás sigue funcionando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan voor Sunlit uit in de systeeminstellingen, dus er komt niets binnen tot ze weer aan staan. Al het andere blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia dla Sunlit są wyłączone w ustawieniach systemowych, więc nic nie dotrze, dopóki nie zostaną włączone. Cała reszta działa dalej."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で Sunlit の通知がオフになっているため、オンに戻すまで何も届きません。他の機能はすべて動き続けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Sunlit nos ajustes do sistema, então nada vai chegar até que sejam reativadas. Todo o resto continua funcionando."
          }
        }
      }
    },
