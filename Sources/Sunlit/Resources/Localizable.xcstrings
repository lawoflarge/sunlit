    "ar.milkyWay.notDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Milky Way is drawn once the sun is more than eighteen degrees below the horizon. It is not dark enough at the selected time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Milchstraße wird gezeichnet, sobald die Sonne mehr als achtzehn Grad unter dem Horizont steht. Zur gewählten Zeit ist es nicht dunkel genug."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Voie lactée n’est tracée que lorsque le Soleil est à plus de dix-huit degrés sous l’horizon. Il ne fait pas assez sombre à l’heure sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Via Lattea viene disegnata quando il Sole scende oltre diciotto gradi sotto l'orizzonte. All'ora selezionata non è abbastanza buio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Vía Láctea se dibuja cuando el sol está más de dieciocho grados por debajo del horizonte. A la hora seleccionada no está lo bastante oscuro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La Vía Láctea se dibuja cuando el sol está más de dieciocho grados bajo el horizonte. No está lo bastante oscuro a la hora seleccionada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Melkweg wordt getekend zodra de zon meer dan achttien graden onder de horizon staat. Op het gekozen tijdstip is het niet donker genoeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droga Mleczna rysuje się, gdy Słońce jest niżej niż osiemnaście stopni pod horyzontem. O wybranej porze nie jest dość ciemno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天の川は、太陽が地平線より18度以上下がってから描かれます。選択した時刻では暗さが足りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Via Láctea é desenhada quando o sol está mais de dezoito graus abaixo do horizonte. Não está escuro o bastante no horário selecionado."
          }
        }
      }
    },
