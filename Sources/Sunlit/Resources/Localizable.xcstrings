    "data.eclipse.noLunar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lunar eclipse falls anywhere in the next five years."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die nächsten fünf Jahre fällt nirgendwo eine Mondfinsternis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune éclipse de Lune ne se produit nulle part dans les cinq prochaines années."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna eclissi lunare cade in alcun luogo nei prossimi cinque anni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cae ningún eclipse lunar en ninguna parte en los próximos cinco años."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No cae ningún eclipse lunar en ninguna parte en los próximos cinco años."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de komende vijf jaar valt er nergens een maansverduistering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciągu najbliższych pięciu lat nigdzie nie wypada żadne zaćmienie Księżyca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後5年、地球上のどこにも月食はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum eclipse lunar acontece em lugar nenhum nos próximos cinco anos."
          }
        }
      }
    },
    "data.eclipse.noMaximum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No part of this eclipse happens while the sun is above the horizon here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Teil dieser Finsternis fällt hier in die Zeit, in der die Sonne über dem Horizont steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune phase de cette éclipse n’a lieu alors que le Soleil est au-dessus de l’horizon ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fase di questa eclissi avviene mentre qui il Sole è sopra l'orizzonte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna parte de este eclipse ocurre mientras el sol está aquí por encima del horizonte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna parte de este eclipse ocurre con el sol sobre el horizonte aquí."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel deel van deze verduistering valt hier terwijl de zon boven de horizon staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna faza tego zaćmienia nie wypada tu, gdy Słońce jest nad horyzontem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食のうち、ここで太陽が地平線より上にある間に起こる部分はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma parte deste eclipse acontece com o sol acima do horizonte aqui."
          }
        }
      }
    },
