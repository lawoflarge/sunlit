          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisione della direzione, più o meno %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisión del rumbo, más o menos %1$@"
          }
        },
        "es-MX": {
