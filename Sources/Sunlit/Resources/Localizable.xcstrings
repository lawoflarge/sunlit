    "ar.sweep.record.axHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim the centre of the frame at the skyline, then hold this button and turn on the spot. One activation takes a single reading, which is how the sweep is done with VoiceOver running"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildmitte auf das Horizontprofil richten, dann diese Taste halten und sich auf der Stelle drehen. Eine einzelne Aktivierung nimmt einen Wert auf, so wird die Aufnahme mit laufendem VoiceOver gemacht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez la ligne d’horizon avec le centre du cadre, puis maintenez ce bouton et tournez sur place. Une activation prend un seul relevé : c’est ainsi que le balayage se fait avec VoiceOver actif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il centro dell'inquadratura sul profilo, poi tieni premuto questo pulsante e gira su te stesso. Una singola attivazione registra una lettura, ed è così che si esegue la scansione con VoiceOver attivo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro del encuadre al perfil, mantén pulsado este botón y gira sobre ti mismo. Una activación toma una sola lectura, que es como se hace el barrido con VoiceOver activado"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro del cuadro al perfil del horizonte, luego mantén presionado este botón y gira sobre tu eje. Una activación toma una sola medición, que es como se hace el barrido con VoiceOver activo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt het midden van het beeld op het horizonprofiel, houd dan deze knop vast en draai op je plek rond. Eén activering neemt één meting, en zo doe je de scan met VoiceOver aan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyceluj środek kadru w linię horyzontu, potem przytrzymaj ten przycisk i obracaj się w miejscu. Jedna aktywacja zapisuje jeden pomiar i w ten sposób wykonuje się skanowanie, gdy działa VoiceOver"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームの中心を稜線に合わせ、このボタンを押したままその場で回ります。1回の操作で1つ読み取るので、VoiceOver 使用時はこの方法で走査します"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o centro do quadro para o perfil, segure este botão e gire no lugar. Uma ativação faz uma única leitura, que é como a varredura é feita com o VoiceOver ligado"
          }
        }
      }
    },
