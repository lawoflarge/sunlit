    "paywall.capability.widgets.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home screen and lock screen: the next event, the day's arc, the golden hour countdown, and sunrise, sunset and moon phase together."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Bildschirm und Sperrbildschirm: das nächste Ereignis, der Tagesbogen, der Countdown zur goldenen Stunde sowie Sonnenaufgang, Sonnenuntergang und Mondphase zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran d’accueil et écran verrouillé : le prochain événement, l’arc de la journée, le compte à rebours de l’heure dorée, et le lever, le coucher et la phase de la Lune réunis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermata Home e schermata di blocco: il prossimo evento, l'arco diurno, il conto alla rovescia per l'ora d'oro e alba, tramonto e fase lunare insieme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla de inicio y pantalla bloqueada: el próximo evento, el arco del día, la cuenta atrás de la hora dorada y la salida, la puesta y la fase lunar juntas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla de inicio y pantalla bloqueada: el próximo evento, el arco del día, la cuenta regresiva de la hora dorada, y salida, puesta y fase lunar juntas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginscherm en toegangsscherm: de volgende gebeurtenis, de dagboog, het aftellen naar het gouden uur, en zonsopgang, zonsondergang en maanfase samen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran główny i ekran blokady: następne zjawisko, łuk dnia, odliczanie do złotej godziny oraz wschód, zachód i faza Księżyca razem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面とロック画面に、次の現象、一日の弧、ゴールデンアワーのカウントダウン、そして日の出、日の入り、月相をまとめて。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela de Início e Tela Bloqueada: o próximo evento, o arco do dia, a contagem regressiva da hora dourada e o nascer do sol, o pôr do sol e a fase da lua juntos."
          }
        }
      }
    },
