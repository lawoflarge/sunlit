    "credits.places.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offline city list is the GeoNames cities15000 extract: every populated place above fifteen thousand people, with its coordinate, elevation and time zone. It is used under the Creative Commons Attribution 4.0 licence, and it is stored in the app so that search works with no network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Offline-Städteliste ist der GeoNames-Auszug cities15000: jeder bewohnte Ort über fünfzehntausend Einwohnern, mit Koordinate, Höhe und Zeitzone. Sie wird unter der Lizenz Creative Commons Attribution 4.0 genutzt und liegt in der App, damit die Suche ohne Netz funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des villes hors ligne est l’extrait GeoNames cities15000 : chaque lieu habité de plus de quinze mille personnes, avec sa coordonnée, son altitude et son fuseau horaire. Elle est utilisée sous licence Creative Commons Attribution 4.0 et elle est stockée dans l’app pour que la recherche fonctionne sans réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco di città integrato è l'estratto GeoNames cities15000: ogni centro abitato sopra i quindicimila abitanti, con la sua coordinata, la sua quota e il suo fuso orario. È usato con licenza Creative Commons Attribuzione 4.0 ed è memorizzato nell'app, così la ricerca funziona senza rete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de ciudades sin conexión es el extracto cities15000 de GeoNames: todos los núcleos de población de más de quince mil habitantes, con su coordenada, su elevación y su zona horaria. Se usa bajo la licencia Creative Commons Atribución 4.0 y se guarda en la app para que la búsqueda funcione sin red."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de ciudades sin conexión es el extracto cities15000 de GeoNames: cada lugar poblado de más de quince mil personas, con su coordenada, su elevación y su zona horaria. Se usa bajo la licencia Creative Commons Attribution 4.0 y se guarda en la app para que la búsqueda funcione sin red."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De offline stedenlijst is het GeoNames uittreksel cities15000: elke bewoonde plaats boven vijftienduizend inwoners, met coördinaat, hoogte en tijdzone. Het wordt gebruikt onder de licentie Creative Commons Attribution 4.0 en zit in de app, zodat zoeken zonder netwerk werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista miast offline to zestaw GeoNames cities15000: każda miejscowość powyżej piętnastu tysięcy mieszkańców, ze współrzędnymi, wysokością i strefą czasową. Używana jest na licencji Creative Commons Attribution 4.0 i przechowywana w aplikacji, aby wyszukiwanie działało bez sieci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインの都市リストは GeoNames の cities15000 抽出データです。人口1万5千人を超えるすべての居住地を、座標、標高、タイムゾーンとともに収録しています。Creative Commons Attribution 4.0 ライセンスのもとで利用し、ネットワークなしで検索できるようアプリ内に保存しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de cidades offline é o extrato cities15000 do GeoNames: todo lugar habitado com mais de quinze mil pessoas, com sua coordenada, elevação e fuso horário. Ela é usada sob a licença Creative Commons Atribuição 4.0 e fica guardada no app para que a busca funcione sem rede."
          }
        }
      }
    },
