    "ar.milkyWay.notDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Milky Way is drawn once the sun is more than eighteen degrees below the horizon. It is not dark enough at the selected time."
          }
        }
      }
    },
    "ar.moon.altitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
