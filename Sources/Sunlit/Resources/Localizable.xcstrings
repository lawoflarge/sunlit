    "widget.goldenRing.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ring counting down to the golden hour, then through it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ring zählt zur goldenen Stunde herunter und dann durch sie hindurch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anneau qui décompte jusqu’à l’heure dorée, puis pendant celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anello che conta alla rovescia fino all'ora d'oro, e poi durante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo que cuenta atrás hasta la hora dorada y luego a lo largo de ella."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo que cuenta hacia la hora dorada, y luego a lo largo de ella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ring die aftelt naar het gouden uur, en er daarna doorheen loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierścień odliczający do złotej godziny, a potem przez nią."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴールデンアワーまで、そしてその間を数えるリング。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um anel em contagem regressiva até a hora dourada e depois ao longo dela."
          }
        }
      }
    },
