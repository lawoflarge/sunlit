    "paywall.capability.anyDate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scout a shoot months ahead, or read back a day from years ago."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Shooting Monate im Voraus planen oder einen Tag von vor Jahren nachschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez une prise de vue des mois à l’avance, ou relisez un jour d’il y a des années."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Studia uno scatto con mesi di anticipo, o rileggi una giornata di anni fa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora un rodaje con meses de antelación, o repasa un día de hace años."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora una sesión con meses de anticipación, o consulta un día de hace años."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verken een shoot maanden vooruit, of lees een dag van jaren geleden terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj zdjęcia z miesięcznym wyprzedzeniem albo odczytaj dzień sprzed lat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数か月先の撮影を下見したり、何年も前の一日を読み返したりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje uma sessão com meses de antecedência ou consulte um dia de anos atrás."
          }
