{
  "sourceLanguage": "en",
  "strings": {
    "accuracy.calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration needed"
          }
        }
      }
    },
    "accuracy.uncertainty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heading accuracy, plus or minus %@"
          }
        }
      }
    },
    "ar.accuracy.calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compass needs calibrating. Move the phone in a figure of eight, and stand clear of metal, magnets and car dashboards."
          }
        }
      }
    },
    "ar.accuracy.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The figure at the top of the frame is the heading accuracy the device reports. The positions themselves are computed, not measured, and are accurate to far better than the compass can be aimed."
          }
        }
      }
    },
    "ar.aim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame centre"
          }
        }
      }
    },
    "ar.aim.altitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame centre altitude"
          }
        }
      }
    },
    "ar.aim.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@° az, %@° alt"
          }
        }
      }
    },
    "ar.camera.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera"
          }
        }
      }
    },
    "ar.camera.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off, so the paths are drawn over the sky colour instead of over your view. Everything else on this screen still works."
          }
        }
      }
    },
    "ar.camera.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is restricted on this device, so the paths are drawn over the sky colour instead. Everything else on this screen still works."
          }
        }
      }
    },
    "ar.camera.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "ar.camera.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no camera here, so the paths are drawn over the sky colour instead. Everything else on this screen still works."
          }
        }
      }
    },
    "ar.camera.undetermined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit can draw these paths over your real view. The image stays on your device and is never recorded or sent anywhere."
          }
        }
      }
    },
