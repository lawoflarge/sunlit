    "paywall.restore.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you bought Sunlit Pro before, restore it here. Restoring may ask you to sign in to your Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer Sunlit Pro schon gekauft hat, stellt es hier wieder her. Beim Wiederherstellen kann eine Anmeldung beim Apple-Account nötig sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez déjà acheté Sunlit Pro, restaurez-le ici. La restauration peut vous demander de vous connecter à votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai già acquistato Sunlit Pro, ripristinalo qui. Il ripristino può chiederti di accedere con il tuo Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya compraste Sunlit Pro antes, restáuralo aquí. Al restaurar puede que se te pida iniciar sesión en tu cuenta de Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya compraste Sunlit Pro, restáuralo aquí. Restaurar puede pedirte que inicies sesión en tu Cuenta de Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je Sunlit Pro eerder gekocht, herstel het dan hier. Bij herstellen wordt mogelijk gevraagd je aan te melden bij je Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Sunlit Pro było już kupione, przywróć je tutaj. Przywracanie może poprosić o zalogowanie się na konto Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前 Sunlit Pro を購入していれば、ここで復元できます。復元の際に Apple アカウントへのサインインを求められることがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
