    "data.milkyWay.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The galactic centre above ten degrees, the sun below eighteen degrees, and no bright moon up. For the night that begins on this date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das galaktische Zentrum über zehn Grad, die Sonne unter achtzehn Grad und kein heller Mond am Himmel. Für die Nacht, die an diesem Tag beginnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre galactique au-dessus de dix degrés, le Soleil sous dix-huit degrés, et pas de Lune brillante levée. Pour la nuit qui commence à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il centro galattico sopra i dieci gradi, il Sole sotto i diciotto gradi e nessuna Luna luminosa in cielo. Per la notte che comincia in questa data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico por encima de diez grados, el sol por debajo de dieciocho grados y ninguna luna brillante en el cielo. Para la noche que empieza en esta fecha."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico sobre diez grados, el sol bajo dieciocho grados, y sin luna brillante en el cielo. Para la noche que empieza en esta fecha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het galactisch centrum boven tien graden, de zon onder achttien graden, en geen heldere maan boven de horizon. Voor de nacht die op deze datum begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum Galaktyki wyżej niż dziesięć stopni, Słońce niżej niż osiemnaście stopni i żadnego jasnego Księżyca nad horyzontem. Dla nocy zaczynającej się w tej dacie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀河中心が10度より高く、太陽が18度より低く、明るい月が出ていない条件です。この日付に始まる夜が対象です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O centro galáctico acima de dez graus, o sol abaixo de dezoito graus e nenhuma lua clara no céu. Para a noite que começa nesta data."
          }
        }
      }
    },
    "data.milkyWay.highestCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest the galactic centre reached at any point in the night, whether or not the sky was dark then."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der höchste Stand, den das galaktische Zentrum irgendwann in der Nacht erreicht, ob der Himmel dann dunkel war oder nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur maximale atteinte par le centre galactique à un moment quelconque de la nuit, que le ciel ait été sombre ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altezza massima raggiunta dal centro galattico in un qualsiasi momento della notte, con il cielo buio o no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más alto que llegó el centro galáctico en algún momento de la noche, hubiera o no cielo oscuro entonces."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más alto que alcanzó el centro galáctico en algún momento de la noche, hubiera o no cielo oscuro entonces."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoogste stand die het galactisch centrum ergens in de nacht bereikte, of de hemel toen donker was of niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższe położenie centrum Galaktyki w ciągu nocy, niezależnie od tego, czy niebo było wtedy ciemne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空が暗かったかどうかにかかわらず、その夜のうちに銀河中心が達した最高高度です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior altura que o centro galáctico alcança em qualquer momento da noite, com o céu escuro ou não."
          }
        }
      }
    },
    "data.milkyWay.highestTonight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest in the night"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchststand in der Nacht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
