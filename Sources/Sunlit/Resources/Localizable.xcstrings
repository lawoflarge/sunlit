    "data.milkyWay.limit.belowHorizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The galactic centre never rises ten degrees above the horizon from this place on this night. It climbs highest from around twenty nine degrees south, where it passes overhead, and sits lower from anywhere further north or further south of that."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das galaktische Zentrum steigt in dieser Nacht von diesem Ort aus nie zehn Grad über den Horizont. Am höchsten steht es bei rund neunundzwanzig Grad Süd, wo es durch den Zenit geht, und tiefer von überall weiter nördlich oder weiter südlich davon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre galactique ne s’élève jamais à dix degrés au-dessus de l’horizon depuis ce lieu cette nuit. Il monte le plus haut vers vingt-neuf degrés de latitude sud, où il passe au zénith, et reste plus bas partout plus au nord ou plus au sud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da questo luogo, in questa notte, il centro galattico non sale mai a dieci gradi sopra l'orizzonte. Sale più in alto da circa ventinove gradi sud, dove passa allo zenit, e resta più basso da qualsiasi punto più a nord o più a sud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico nunca sube diez grados sobre el horizonte desde este lugar en esta noche. Alcanza su mayor altura hacia los veintinueve grados sur, donde pasa por el cenit, y queda más bajo desde cualquier punto más al norte o más al sur."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico nunca sube diez grados sobre el horizonte desde este lugar esta noche. Alcanza su mayor altura cerca de los veintinueve grados sur, donde pasa por el cenit, y se ve más bajo desde cualquier punto más al norte o más al sur de esa latitud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het galactisch centrum komt vannacht vanaf deze plaats nooit tien graden boven de horizon. Het klimt het hoogst rond negenentwintig graden zuiderbreedte, waar het door het zenit gaat, en staat lager overal verder naar het noorden of verder naar het zuiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum Galaktyki nie wznosi się tej nocy w tym miejscu dziesięć stopni nad horyzont. Najwyżej wchodzi w okolicach dwudziestu dziewięciu stopni szerokości południowej, gdzie przechodzi przez zenit, a dalej na północ i dalej na południe od tej szerokości stoi niżej."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜、この地点では銀河中心が地平線より10度以上高くは昇りません。最も高くなるのは南緯29度あたりで、そこでは天頂を通ります。それより北でも南でも低くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O centro galáctico nunca sobe dez graus acima do horizonte deste local nesta noite. Ele sobe mais alto por volta de vinte e nove graus de latitude sul, onde passa pelo zênite, e fica mais baixo visto de qualquer ponto mais ao norte ou mais ao sul disso."
          }
        }
      }
    },
    "data.milkyWay.limit.moonlight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bright moon is above the horizon through every dark hour of this night. Wait for a thinner moon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In jeder dunklen Stunde dieser Nacht steht ein heller Mond über dem Horizont. Auf einen dünneren Mond warten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Lune brillante reste au-dessus de l’horizon pendant toutes les heures sombres de cette nuit. Attendez une Lune plus fine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Luna luminosa è sopra l'orizzonte in tutte le ore buie di questa notte. Aspetta una Luna più sottile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luna brillante está sobre el horizonte durante todas las horas oscuras de esta noche. Espera a una luna más fina."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una luna brillante sobre el horizonte durante cada hora oscura de esta noche. Espera a una luna más delgada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een heldere maan staat vannacht elk donker uur boven de horizon. Wacht op een dunnere maan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasny Księżyc jest nad horyzontem przez każdą ciemną godzinę tej nocy. Poczekaj na cieńszy Księżyc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜は暗い時間のあいだずっと明るい月が地平線より上にあります。月が細くなるのを待ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lua clara fica acima do horizonte em todas as horas escuras desta noite. Espere uma lua mais fina."
          }
        }
      }
    },
    "data.milkyWay.limit.season": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The galactic centre is high, and the night is dark, but never at the same time. This is the wrong half of the year at this latitude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das galaktische Zentrum steht hoch und die Nacht ist dunkel, aber nie zur selben Zeit. Das ist auf dieser Breite die falsche Jahreshälfte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre galactique est haut et la nuit est sombre, mais jamais en même temps. Ce n’est pas la bonne moitié de l’année à cette latitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il centro galattico è alto e la notte è buia, ma mai nello stesso momento. A questa latitudine è la metà sbagliata dell'anno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico está alto y la noche es oscura, pero nunca a la vez. Esta es la mitad del año equivocada para esta latitud."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico está alto, y la noche es oscura, pero nunca al mismo tiempo. Es la mitad equivocada del año en esta latitud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het galactisch centrum staat hoog en de nacht is donker, maar nooit tegelijk. Dit is de verkeerde helft van het jaar op deze breedtegraad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum Galaktyki jest wysoko, a noc jest ciemna, ale nigdy w tym samym czasie. To zła połowa roku na tej szerokości geograficznej."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀河中心は高く、夜も暗くなりますが、同時にはなりません。この緯度では1年のうち適さない側の半年です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O centro galáctico fica alto e a noite fica escura, mas nunca ao mesmo tempo. Esta é a metade errada do ano nesta latitude."
          }
        }
      }
    },
    "data.milkyWay.limit.twilight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun never sinks eighteen degrees below the horizon on this night, so the sky never becomes astronomically dark. This is the high latitude summer, whichever hemisphere you are in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne sinkt in dieser Nacht nie achtzehn Grad unter den Horizont, der Himmel wird also nie astronomisch dunkel. Das ist der Sommer in hohen Breiten, in welcher Hemisphäre auch immer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne descend jamais à dix-huit degrés sous l’horizon cette nuit : le ciel n’atteint donc jamais l’obscurité astronomique. C’est l’été des hautes latitudes, quel que soit l’hémisphère où vous êtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa notte il Sole non scende mai diciotto gradi sotto l'orizzonte, quindi il cielo non diventa mai astronomicamente buio. È l'estate delle alte latitudini, in qualunque emisfero ti trovi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol nunca baja dieciocho grados por debajo del horizonte en esta noche, así que el cielo nunca llega a la oscuridad astronómica. Es el verano de las latitudes altas, estés en el hemisferio que estés."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol nunca baja dieciocho grados bajo el horizonte esta noche, así que el cielo nunca llega a la oscuridad astronómica. Es el verano de las latitudes altas, sea cual sea el hemisferio en que estés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon zakt vannacht nooit achttien graden onder de horizon, dus de hemel wordt nooit astronomisch donker. Dit is de zomer op hoge breedte, op welk halfrond je ook bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce nie schodzi tej nocy osiemnaście stopni pod horyzont, więc niebo nigdy nie staje się astronomicznie ciemne. To lato na wysokich szerokościach geograficznych, na obu półkulach tak samo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜は太陽が地平線より18度下まで沈まないため、空が天文学的に暗くなることはありません。どちらの半球でも、高緯度の夏に起こる状況です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol nunca desce dezoito graus abaixo do horizonte nesta noite, então o céu nunca fica astronomicamente escuro. É o verão de latitude alta, seja qual for o hemisfério em que você está."
          }
        }
      }
    },
    "data.milkyWay.limit.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no window on the galactic centre on this night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Nacht gibt es kein Fenster auf das galaktische Zentrum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucune fenêtre sur le centre galactique cette nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa notte non c'è una finestra sul centro galattico."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ventana para el centro galáctico en esta noche."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ventana para el centro galáctico esta noche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is vannacht geen venster op het galactisch centrum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej nocy nie ma okna na centrum Galaktyki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夜、銀河中心を見られる時間帯はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há janela para o centro galáctico nesta noite."
          }
        }
      }
    },
