    "data.eclipse.umbralCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the moon's diameter is inside the dark shadow at maximum, as a share of that diameter. Above one the whole moon is inside it. Below zero the moon misses the umbra altogether."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel vom Monddurchmesser im Maximum im Kernschatten liegt, als Anteil dieses Durchmessers. Über eins liegt der ganze Mond darin. Unter null verfehlt der Mond den Kernschatten ganz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part du diamètre de la Lune qui se trouve dans l’ombre au maximum, rapportée à ce diamètre. Au-dessus de un, la Lune y est entièrement. Sous zéro, la Lune manque complètement l’ombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanta parte del diametro della Luna si trova dentro l'ombra scura al massimo, come frazione di quel diametro. Sopra uno la Luna è tutta dentro. Sotto zero la Luna manca del tutto l'ombra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto del diámetro de la luna queda dentro de la umbra en el máximo, como fracción de ese diámetro. Por encima de uno, la luna entera está dentro. Por debajo de cero, la luna no llega a tocar la umbra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto del diámetro de la luna queda dentro de la sombra oscura en el máximo, como fracción de ese diámetro. Por encima de uno, toda la luna está dentro. Por debajo de cero, la luna no toca la umbra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel van de maansdiameter bij het maximum in de kernschaduw ligt, als deel van die diameter. Boven één zit de hele maan erin. Onder nul mist de maan de umbra volledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaka część średnicy Księżyca jest w cieniu właściwym w maksimum, wyrażona ułamkiem tej średnicy. Powyżej jeden cały Księżyc mieści się w środku. Poniżej zera Księżyc w ogóle nie trafia w cień właściwy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食甚時に本影に入る月の直径の割合を、その直径に対する比で表します。1を超えると月全体が本影の中にあり、0を下回ると月は本影にまったく入りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto do diâmetro da lua está dentro da sombra escura no máximo, como fração desse diâmetro. Acima de um, a lua inteira está dentro dela. Abaixo de zero, a lua não encosta na umbra."
          }
        }
      }
    },
