    "data.export.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A spreadsheet of every figure on this screen, and a picture of the day to send on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle mit jedem Wert auf diesem Bildschirm und ein Bild des Tages zum Weitergeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille de calcul reprenant chaque valeur de cet écran, et une image de la journée à transmettre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio di calcolo con ogni valore di questa schermata e un'immagine della giornata da inviare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de cálculo con todas las cifras de esta pantalla, y una imagen del día para enviar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de cálculo con cada cifra de esta pantalla, y una imagen del día para compartir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een spreadsheet met elk cijfer op dit scherm, en een afbeelding van de dag om door te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz ze wszystkimi wartościami z tego ekranu oraz obraz dnia do wysłania dalej."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面のすべての数値の表計算ファイルと、そのまま送れる一日の画像です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma planilha com todos os valores desta tela e uma imagem do dia para enviar."
          }
        }
      }
    },
    "data.export.csvDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per figure, with a header row, the unit it is expressed in, and a note wherever a value is absent that says why."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile je Wert, mit einer Kopfzeile, der Einheit, in der er angegeben ist, und einer Notiz überall dort, wo ein Wert fehlt, die den Grund nennt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne par valeur, avec une ligne d’en-tête, l’unité employée, et une note expliquant pourquoi partout où une valeur est absente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga per valore, con una riga di intestazione, l'unità in cui è espresso e, dove un valore manca, una nota che spiega perché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila por cifra, con fila de encabezado, la unidad en que se expresa y una nota allí donde falte un valor que explique por qué."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila por cifra, con una fila de encabezado, la unidad en que se expresa, y una nota donde falte un valor que dice por qué."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rij per cijfer, met een koprij, de eenheid waarin het is uitgedrukt, en bij elke ontbrekende waarde een notitie die zegt waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden wiersz na wartość, z wierszem nagłówka, jednostką, w której jest wyrażona, i notatką wyjaśniającą, gdziekolwiek wartości brakuje, dlaczego jej nie ma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの数値につき1行で、見出し行、その数値を表す単位、そして値がない場合はその理由を記した注記が付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por valor, com uma linha de cabeçalho, a unidade em que ele é expresso e, sempre que um valor faltar, uma nota dizendo por quê."
          }
        }
      }
    },
