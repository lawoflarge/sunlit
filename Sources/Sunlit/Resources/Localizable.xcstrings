    "horizon.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apparent height of whatever stands in each direction, in degrees. Zero is an open sea horizon. A hilltop looking down at the sea takes a value below zero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die scheinbare Höhe dessen, was in der jeweiligen Richtung steht, in Grad. Null ist ein freier Seehorizont. Eine Kuppe mit Blick hinab aufs Meer bekommt einen Wert unter null."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur apparente de ce qui se dresse dans chaque direction, en degrés. Zéro correspond à un horizon de pleine mer. Un sommet qui domine la mer prend une valeur inférieure à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altezza apparente di ciò che si trova in ogni direzione, in gradi. Zero è l'orizzonte di mare aperto. Una cima che guarda il mare dall'alto prende un valore sotto zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura aparente de lo que se levanta en cada dirección, en grados. Cero es un horizonte de mar abierto. Una cima que mira hacia abajo al mar toma un valor por debajo de cero."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura aparente de lo que se levanta en cada dirección, en grados. Cero es un horizonte de mar abierto. Una cima que mira al mar hacia abajo toma un valor menor que cero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijnbare hoogte van wat er in elke richting staat, in graden. Nul is een vrije zeehorizon. Een heuveltop die op zee uitkijkt krijgt een waarde onder nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozorna wysokość tego, co stoi w każdym kierunku, w stopniach. Zero to otwarty horyzont morski. Szczyt wzgórza patrzący w dół na morze przyjmuje wartość poniżej zera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの方向に立つものの見かけの高さを度で表します。0は開けた海の地平線です。海を見下ろす丘の上なら0より小さい値になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A altura aparente do que está em cada direção, em graus. Zero é um horizonte de mar aberto. Um topo de morro que olha para o mar lá embaixo recebe um valor abaixo de zero."
          }
        }
      }
    },
    "horizon.gate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is here to read. Changing it, and the true sunrise and obstruction times it produces, are part of Sunlit Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabelle ist zum Lesen da. Änderungen daran und die echten Zeiten für Aufgang und Verdeckung, die daraus entstehen, gehören zu Sunlit Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau est là pour être consulté. Le modifier, et obtenir les vraies heures de lever et d’obstruction qu’il produit, fait partie de Sunlit Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella è qui per essere letta. Modificarla, con gli orari veri di alba e i periodi in cui il Sole resta nascosto che ne derivano, fa parte di Sunlit Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla está aquí para leerla. Cambiarla, y las horas reales de salida y de obstrucción que produce, forma parte de Sunlit Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla está aquí para leerse. Cambiarla, y las horas reales de salida y de obstrucción que produce, son parte de Sunlit Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabel is er om te lezen. Hem wijzigen, en de echte zonsopgang en obstructietijden die dat oplevert, horen bij Sunlit Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelę można czytać. Jej zmiana oraz wynikające z niej rzeczywiste godziny wschodu i zasłonięcia są częścią Sunlit Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この表は読むためのものです。表の変更と、そこから得られる本当の日の出や遮蔽の時刻は Sunlit Pro の機能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela está aqui para ser lida. Alterá-la faz parte do Sunlit Pro, assim como os horários reais de nascer do sol e de obstrução que isso produz."
          }
        }
      }
    },
