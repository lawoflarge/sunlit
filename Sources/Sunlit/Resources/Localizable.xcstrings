    "data.twilight.astronomical.neverDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not sink eighteen degrees below the horizon on this date, so the night never becomes astronomically dark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne sinkt an diesem Tag nicht achtzehn Grad unter den Horizont, die Nacht wird also nie astronomisch dunkel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne descend pas à dix-huit degrés sous l’horizon à cette date : la nuit n’atteint donc jamais l’obscurité astronomique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data il Sole non scende diciotto gradi sotto l'orizzonte, quindi la notte non diventa mai astronomicamente buia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja dieciocho grados por debajo del horizonte en esta fecha, así que la noche nunca llega a la oscuridad astronómica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja dieciocho grados bajo el horizonte en esta fecha, así que la noche nunca llega a la oscuridad astronómica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon zakt op deze datum niet achttien graden onder de horizon, dus de nacht wordt nooit astronomisch donker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej dacie Słońce nie schodzi osiemnaście stopni pod horyzont, więc noc nigdy nie staje się astronomicznie ciemna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付、太陽は地平線より18度下まで沈まないため、夜が天文学的に暗くなることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol não desce dezoito graus abaixo do horizonte nesta data, então a noite nunca fica astronomicamente escura."
          }
        }
      }
    },
    "data.twilight.astronomical.neverLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays more than eighteen degrees below the horizon all day here. It is astronomically dark throughout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag mehr als achtzehn Grad unter dem Horizont. Es ist durchgehend astronomisch dunkel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste à plus de dix-huit degrés sous l’horizon toute la journée ici. L’obscurité astronomique dure sans interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta oltre diciotto gradi sotto l'orizzonte per tutto il giorno. È astronomicamente buio per l'intera giornata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene más de dieciocho grados por debajo del horizonte todo el día. Hay oscuridad astronómica todo el tiempo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene más de dieciocho grados bajo el horizonte todo el día aquí. Hay oscuridad astronómica todo el tiempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag meer dan achttien graden onder de horizon. Het is de hele tijd astronomisch donker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez całą dobę niżej niż osiemnaście stopni pod horyzontem. Przez cały czas jest astronomicznie ciemno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽がこの日ずっと地平線より18度以上下にあります。終日、天文学的に暗い状態が続きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica mais de dezoito graus abaixo do horizonte o dia todo aqui. Está astronomicamente escuro o tempo inteiro."
          }
        }
      }
    },
