    "data.sun.noSunrise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not cross the horizon upward on this date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne quert an diesem Tag den Horizont nicht nach oben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne franchit pas l’horizon vers le haut à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data il Sole non attraversa l'orizzonte verso l'alto."
