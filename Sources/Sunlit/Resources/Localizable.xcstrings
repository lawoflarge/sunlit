    "data.annual.belowHorizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the curve runs under the horizon line the sun does not rise at all on that date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Kurve unter der Horizontlinie verläuft, geht die Sonne an diesem Tag gar nicht auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où la courbe passe sous la ligne d’horizon, le Soleil ne se lève pas du tout à cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove la curva passa sotto la linea dell'orizzonte, in quella data il Sole non sorge affatto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde la curva pasa por debajo de la línea del horizonte, el sol no llega a salir en esa fecha."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde la curva pasa bajo la línea del horizonte, el sol no sale en esa fecha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de curve onder de horizonlijn loopt, komt de zon op die datum helemaal niet op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam, gdzie krzywa biegnie pod linią horyzontu, Słońce w tej dacie w ogóle nie wschodzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線が地平線より下を通る日付では、太陽はまったく昇りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde a curva passa abaixo da linha do horizonte, o sol não nasce nessa data."
          }
        }
      }
    },
    "data.annual.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest the sun reaches on each date of the year at this place. The four light uprights are the equinoxes and the solstices. The heavier one is the date you have selected, which is a fifth upright on all but those four dates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der höchste Stand der Sonne an jedem Tag des Jahres an diesem Ort. Die vier hellen Senkrechten sind die Äquinoktien und die Sonnenwenden. Die kräftigere ist der gewählte Tag, an allen übrigen Tagen also eine fünfte Senkrechte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur maximale atteinte par le Soleil à chaque date de l’année pour ce lieu. Les quatre verticales claires sont les équinoxes et les solstices. La plus épaisse est la date que vous avez sélectionnée : elle forme une cinquième verticale, sauf à ces quatre dates."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altezza massima che il Sole raggiunge in ogni data dell'anno in questo luogo. Le quattro linee verticali chiare sono gli equinozi e i solstizi. Quella più marcata è la data selezionata, che è una quinta verticale in tutte le date tranne quelle quattro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más alto que llega el sol en cada fecha del año en este lugar. Las cuatro verticales claras son los equinoccios y los solsticios. La más marcada es la fecha que has seleccionado, que es una quinta vertical salvo en esas cuatro fechas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más alto que llega el sol en cada fecha del año en este lugar. Las cuatro verticales claras son los equinoccios y los solsticios. La más gruesa es la fecha que seleccionaste, que es una quinta vertical salvo en esas cuatro fechas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoogste stand die de zon op elke datum van het jaar op deze plaats bereikt. De vier lichte verticalen zijn de equinoxen en de zonnewendes. De zwaardere is de datum die je hebt gekozen, en dat is een vijfde verticaal op alle datums behalve die vier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższe położenie Słońca w każdym dniu roku w tym miejscu. Cztery jasne pionowe linie to równonoce i przesilenia. Grubsza to wybrana data, czyli piąta pionowa linia we wszystkie dni poza tamtymi czterema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地点で1年の各日付に太陽が届く最高高度です。細い4本の縦線は分点と至点、太い1本は選択中の日付で、その4日以外では5本目の縦線になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maior altura que o sol alcança em cada data do ano neste local. As quatro linhas verticais claras são os equinócios e os solstícios. A mais forte é a data que você selecionou, que forma uma quinta linha em todas as datas menos essas quatro."
          }
        }
      }
    },
