    "sky.moon.riseOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises %@, no moonset on this day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgang %1$@, an diesem Tag kein Monduntergang"
