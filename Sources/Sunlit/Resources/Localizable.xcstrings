    "paywall.capability.annualPaths.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "June solstice, December solstice and equinox paths drawn as reference, plus the year's altitude curve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahnen zur Sonnenwende im Juni, zur Sonnenwende im Dezember und zum Äquinoktium als Referenz, dazu die Höhenkurve des Jahres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les courses du solstice de juin, du solstice de décembre et de l’équinoxe tracées en repère, plus la courbe des hauteurs de l’année."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percorsi del solstizio di giugno, del solstizio di dicembre e degli equinozi disegnati come riferimento, più la curva delle altezze dell'anno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trayectorias del solsticio de junio, del solsticio de diciembre y de los equinoccios como referencia, más la curva de altura del año."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Trayectorias del solsticio de junio, del solsticio de diciembre y del equinoccio dibujadas como referencia, más la curva de altura del año."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Banen van junizonnewende, decemberzonnewende en equinox als referentie, plus de hoogtecurve van het jaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drogi z przesilenia czerwcowego, przesilenia grudniowego i równonocy jako odniesienie oraz roczna krzywa wysokości."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6月至点、12月至点、分点の軌道を参照として描き、1年の高度曲線も加わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As trajetórias do solstício de junho, do solstício de dezembro e do equinócio desenhadas como referência, mais a curva de altitude do ano."
          }
        }
      }
    },
