    "paywall.capability.notifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts for sun and moon events, scheduled on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise zu Ereignissen von Sonne und Mond, auf dem Gerät geplant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des alertes pour les événements du Soleil et de la Lune, programmées sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi per gli eventi del Sole e della Luna, programmati sul tuo dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
