    "paywall.capability.moon.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, illuminated fraction, distance, rise and set, its path in every view, and the phase calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, beleuchteter Anteil, Entfernung, Aufgang und Untergang, die Bahn in jeder Ansicht und der Phasenkalender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, fraction éclairée, distance, lever et coucher, sa course dans chaque vue, et le calendrier des phases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, frazione illuminata, distanza, sorgere e tramonto, il suo percorso in ogni vista e il calendario delle fasi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, fracción iluminada, distancia, salida y puesta, su trayectoria en todas las vistas y el calendario de fases."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, fracción iluminada, distancia, salida y puesta, su trayectoria en cada vista, y el calendario de fases."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, verlichte fractie, afstand, opkomst en ondergang, de baan in elke weergave, en de fasekalender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Faza, część oświetlona, odległość, wschód i zachód, droga w każdym widoku oraz kalendarz faz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月相、輝面比、距離、月の出と月の入り、各ビューでの軌道、そして月相カレンダー。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, fração iluminada, distância, nascer e pôr, a trajetória dela em todas as visualizações e o calendário de fases."
          }
        }
      }
    },
