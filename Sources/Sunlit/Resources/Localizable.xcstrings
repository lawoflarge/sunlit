    "paywall.price.terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One time purchase. Nothing renews, and there is nothing to cancel. It stays unlocked on every device signed in to the same Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Nichts verlängert sich, und es gibt nichts zu kündigen. Es bleibt auf jedem Gerät freigeschaltet, das im selben Apple-Account angemeldet ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Rien ne se renouvelle et il n’y a rien à résilier. Tout reste déverrouillé sur chaque appareil connecté au même compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Non si rinnova nulla e non c'è nulla da disdire. Resta sbloccato su ogni dispositivo con lo stesso Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. No se renueva nada y no hay nada que cancelar. Sigue desbloqueado en todos los dispositivos con la misma cuenta de Apple."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Nada se renueva y no hay nada que cancelar. Queda desbloqueado en cada dispositivo con sesión iniciada en la misma Cuenta de Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Er wordt niets verlengd en er valt niets op te zeggen. Het blijft ontgrendeld op elk apparaat dat is aangemeld bij hetzelfde Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup jednorazowy. Nic się nie odnawia i nie ma czego anulować. Pozostaje odblokowane na każdym urządzeniu zalogowanym na to samo konto Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りの購入です。更新はなく、解約するものもありません。同じ Apple アカウントでサインインしたすべての端末で解除されたままになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Nada renova e não há nada para cancelar. Continua desbloqueado em todo dispositivo conectado à mesma Conta Apple."
          }
        }
      }
    },
