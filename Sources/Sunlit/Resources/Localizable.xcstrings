    "data.moon.noRiseToday": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon does not rise on this date. It rises about fifty minutes later each day, so roughly once a month a date has no moonrise in it at all."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond geht an diesem Tag nicht auf. Er geht jeden Tag rund fünfzig Minuten später auf, deshalb hat etwa einmal im Monat ein Tag gar keinen Mondaufgang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune ne se lève pas à cette date. Elle se lève environ cinquante minutes plus tard chaque jour : à peu près une fois par mois, une date ne contient aucun lever de Lune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data la Luna non sorge. Sorge circa cinquanta minuti più tardi ogni giorno, quindi all'incirca una volta al mese capita una data senza alcun sorgere della Luna."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna no sale en esta fecha. Sale unos cincuenta minutos más tarde cada día, así que más o menos una vez al mes hay una fecha sin ninguna salida de la luna."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna no sale en esta fecha. Sale unos cincuenta minutos más tarde cada día, así que casi una vez al mes hay una fecha sin ninguna salida de la luna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maan komt op deze datum niet op. Ze komt elke dag ongeveer vijftig minuten later op, dus ruwweg eens per maand valt er helemaal geen maansopkomst in een datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Księżyc nie wschodzi w tej dacie. Wschodzi każdego dnia około pięćdziesięciu minut później, więc mniej więcej raz w miesiącu w dobie nie ma wschodu Księżyca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付に月の出はありません。月の出は毎日およそ50分ずつ遅くなるため、ほぼ1か月に1度、月の出がまったくない日付が現れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua não nasce nesta data. Ela nasce cerca de cinquenta minutos mais tarde a cada dia, então mais ou menos uma vez por mês uma data fica sem nenhum nascer da lua."
          }
        }
      }
    },
    "data.moon.noSetToday": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon does not set on this date. It sets about fifty minutes later each day, so roughly once a month a date has no moonset in it at all."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond geht an diesem Tag nicht unter. Er geht jeden Tag rund fünfzig Minuten später unter, deshalb hat etwa einmal im Monat ein Tag gar keinen Monduntergang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune ne se couche pas à cette date. Elle se couche environ cinquante minutes plus tard chaque jour : à peu près une fois par mois, une date ne contient aucun coucher de Lune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data la Luna non tramonta. Tramonta circa cinquanta minuti più tardi ogni giorno, quindi all'incirca una volta al mese capita una data senza alcun tramonto della Luna."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna no se pone en esta fecha. Se pone unos cincuenta minutos más tarde cada día, así que más o menos una vez al mes hay una fecha sin ninguna puesta de la luna."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna no se pone en esta fecha. Se pone unos cincuenta minutos más tarde cada día, así que casi una vez al mes hay una fecha sin ninguna puesta de la luna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maan gaat op deze datum niet onder. Ze gaat elke dag ongeveer vijftig minuten later onder, dus ruwweg eens per maand valt er helemaal geen maansondergang in een datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Księżyc nie zachodzi w tej dacie. Zachodzi każdego dnia około pięćdziesięciu minut później, więc mniej więcej raz w miesiącu w dobie nie ma zachodu Księżyca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付に月の入りはありません。月の入りは毎日およそ50分ずつ遅くなるため、ほぼ1か月に1度、月の入りがまったくない日付が現れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua não se põe nesta data. Ela se põe cerca de cinquenta minutos mais tarde a cada dia, então mais ou menos uma vez por mês uma data fica sem nenhum pôr da lua."
          }
        }
      }
    },
