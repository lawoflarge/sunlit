    "data.eclipse.sunSetFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun sets here before the discs part, so there is no last contact to see."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne geht hier unter, bevor sich die Scheiben trennen, es gibt also keinen letzten Kontakt zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil se couche ici avant que les disques ne se séparent : il n’y a donc pas de dernier contact à voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole tramonta prima che i dischi si separino, quindi non c'è un ultimo contatto da vedere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se pone antes de que los discos se separen, así que no hay último contacto que ver."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se pone aquí antes de que los discos se separen, así que no hay último contacto que ver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon gaat hier onder voordat de schijven scheiden, dus er is geen laatste contact te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce zachodzi tu, zanim tarcze się rozejdą, więc ostatniego kontaktu nie da się zobaczyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの円が離れる前にここでは太陽が沈むため、見られる食の終わりはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol se põe aqui antes de os discos se separarem, então não há último contato para ver."
          }
        }
      }
    },
