    "settings.purchase.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever, in all four views. One purchase adds every other date and place, the moon, the Milky Way, annual paths, a swept skyline, eclipses, widgets, notifications and export."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute am aktuellen Standort ist für immer gratis, in allen vier Ansichten. Ein Kauf ergänzt jedes andere Datum und jeden anderen Ort, den Mond, die Milchstraße, die Jahresbahnen, ein aufgenommenes Horizontprofil, Finsternisse, Widgets, Mitteilungen und den Export."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui à votre position actuelle est gratuit pour toujours, dans les quatre vues. Un seul achat ajoute toutes les autres dates et tous les autres lieux, la Lune, la Voie lactée, les courses annuelles, une ligne d’horizon balayée, les éclipses, les widgets, les notifications et l’exportation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nella tua posizione attuale è gratis per sempre, in tutte e quattro le viste. Un unico acquisto aggiunge ogni altra data e ogni altro luogo, la Luna, la Via Lattea, i percorsi annuali, un profilo scansionato, le eclissi, i widget, le notifiche e l'esportazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre, en las cuatro vistas. Una compra añade todas las demás fechas y lugares, la luna, la Vía Láctea, las trayectorias anuales, un perfil barrido, los eclipses, los widgets, los avisos y la exportación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre, en las cuatro vistas. Una compra agrega todas las demás fechas y lugares, la luna, la Vía Láctea, las trayectorias anuales, un perfil del horizonte barrido, los eclipses, los widgets, las notificaciones y la exportación."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je huidige locatie is voor altijd gratis, in alle vier de weergaven. Eén aankoop voegt elke andere datum en plaats toe, de maan, de Melkweg, jaarbanen, een gescand horizonprofiel, verduisteringen, widgets, meldingen en export."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dzień w bieżącej lokalizacji jest darmowy na zawsze, we wszystkich czterech widokach. Jeden zakup dodaje każdą inną datę i miejsce, Księżyc, Drogę Mleczną, roczne drogi Słońca, zeskanowaną linię horyzontu, zaćmienia, widżety, powiadomienia i eksport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の今日は、4つのビューすべてで永久に無料です。1回の購入で、他のすべての日付と地点、月、天の川、年間の軌道、走査した稜線、日食と月食、ウィジェット、通知、書き出しが加わります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na sua localização atual é grátis para sempre, nas quatro visualizações. Uma compra adiciona todas as outras datas e locais, a lua, a Via Láctea, as trajetórias anuais, um perfil varrido, os eclipses, os widgets, as notificações e a exportação."
          }
        }
      }
    },
