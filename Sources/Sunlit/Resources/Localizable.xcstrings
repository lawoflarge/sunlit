    "map.zone.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times shown in your device time zone, %@. This pin's own time zone needs a network lookup, so it has not been confirmed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten in der Zeitzone des Geräts, %1$@. Die eigene Zeitzone dieser Markierung braucht eine Abfrage über das Netz und ist daher nicht bestätigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures indiquées dans le fuseau horaire de votre appareil, %1$@. Le fuseau propre à ce repère demande une recherche réseau : il n’est donc pas confirmé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orari mostrati nel fuso orario del tuo dispositivo, %1$@. Il fuso orario di questo segnaposto richiede una ricerca in rete, quindi non è stato confermato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas mostradas en la zona horaria de tu dispositivo, %1$@. La zona horaria propia de este marcador necesita una consulta por red, así que no se ha confirmado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas mostradas en la zona horaria de tu dispositivo, %1$@. La zona horaria propia de este pin necesita una consulta en red, así que no se ha confirmado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijden getoond in de tijdzone van je toestel, %1$@. De eigen tijdzone van deze speld vraagt een opzoeking via het netwerk, dus die is niet bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny w strefie czasowej urządzenia, %1$@. Własna strefa czasowa tej pinezki wymaga sprawdzenia przez sieć, więc nie została potwierdzona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻は端末のタイムゾーン %1$@ で表示しています。このピン自身のタイムゾーンはネットワーク照会が必要なため、まだ確認できていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Horários mostrados no fuso horário do seu dispositivo, %1$@. O fuso horário deste marcador precisa de uma consulta pela rede, então ele ainda não foi confirmado."
          }
        }
      }
    },
