            "state": "translated",
            "value": "Moon azimuth"
          }
        }
      }
    },
    "ar.moon.lit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon lit"
          }
        }
      }
    },
    "ar.moon.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon is part of Sunlit Pro: its path over your view, its phase, and its rise and set with parallax."
          }
        }
      }
    },
    "ar.moon.lockedSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever. Another day or another place is part of Sunlit Pro."
          }
        }
      }
    },
    "ar.optics.assumed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is reporting its lens here, so the overlay is drawn at an assumed field of view."
          }
        }
      }
    },
    "ar.selection.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever. This screen is showing another day or another place, so the figures and the overlay are dimmed until Sunlit Pro is unlocked."
          }
        }
      }
    },
    "ar.skyline.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dashed line is the skyline swept at this place."
          }
        }
      }
    },
    "ar.sun.altitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
