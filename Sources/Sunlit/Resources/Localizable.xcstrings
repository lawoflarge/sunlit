    "data.twilight.civil.neverLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays more than six degrees below the horizon all day here, so civil twilight does not begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag mehr als sechs Grad unter dem Horizont, die bürgerliche Dämmerung beginnt also nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste à plus de six degrés sous l’horizon toute la journée ici : le crépuscule civil ne commence donc pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta oltre sei gradi sotto l'orizzonte per tutto il giorno, quindi il crepuscolo civile non comincia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene más de seis grados por debajo del horizonte todo el día, así que el crepúsculo civil no empieza."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene más de seis grados bajo el horizonte todo el día aquí, así que el crepúsculo civil no empieza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag meer dan zes graden onder de horizon, dus de burgerlijke schemering begint niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez całą dobę niżej niż sześć stopni pod horyzontem, więc zmierzch cywilny się nie zaczyna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽がこの日ずっと地平線より6度以上下にあるため、常用薄明は始まりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica mais de seis graus abaixo do horizonte o dia todo aqui, então o crepúsculo civil não começa."
          }
        }
      }
    },
