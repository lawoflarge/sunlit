    "data.golden.noCrossing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not cross this band on this side of solar noon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne quert dieses Band auf dieser Seite des wahren Mittags nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne traverse pas cette bande de ce côté du midi solaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Sole non attraversa questa fascia da questo lato del mezzogiorno solare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no cruza esta franja en este lado del mediodía solar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no cruza esta franja de este lado del mediodía solar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon kruist deze band niet aan deze kant van de zonnemiddag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce nie przecina tego pasma po tej stronie południa słonecznego."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太陽は太陽正午のこちら側でこの帯を横切りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol não cruza esta faixa deste lado do meio-dia solar."
          }
        }
      }
    },
    "data.golden.staysAbove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays above this band all day here, so there is no window."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag über diesem Band, es gibt also kein Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste au-dessus de cette bande toute la journée ici : il n’y a donc pas de fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta sopra questa fascia per tutto il giorno, quindi non c'è una finestra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene por encima de esta franja todo el día, así que no hay ventana."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene sobre esta franja todo el día aquí, así que no hay ventana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag boven deze band, dus er is geen venster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez całą dobę nad tym pasmem, więc nie ma okna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽がこの日ずっとこの帯より上にあるため、該当する時間帯はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica acima desta faixa o dia todo aqui, então não há janela."
          }
        }
      }
    },
