    "paywall.capability.savedPlaces.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search more than thirty thousand cities offline, drop a pin anywhere, and keep the places you work at."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr als dreißigtausend Städte offline durchsuchen, überall eine Markierung setzen und die eigenen Arbeitsorte behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez parmi plus de trente mille villes hors ligne, déposez un repère où vous voulez, et conservez les lieux où vous travaillez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca più di trentamila città senza rete, metti un segnaposto ovunque e conserva i luoghi in cui lavori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca más de treinta mil ciudades sin conexión, suelta un marcador donde quieras y guarda los lugares en los que trabajas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca más de treinta mil ciudades sin conexión, coloca un pin donde sea, y guarda los lugares donde trabajas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek offline in meer dan dertigduizend steden, plaats overal een speld, en bewaar de plaatsen waar je werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukuj ponad trzydzieści tysięcy miast bez sieci, stawiaj pinezkę gdziekolwiek i zachowuj miejsca, w których pracujesz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3万を超える都市をオフラインで検索し、どこにでもピンを置き、仕事で使う地点を保存できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque mais de trinta mil cidades offline, solte um marcador em qualquer lugar e guarde os locais onde você trabalha."
          }
        }
      }
    },
