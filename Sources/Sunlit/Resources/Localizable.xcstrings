          }
        }
      }
    },
    "ar.sweep.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over"
          }
        }
      }
    },
    "ar.sweep.clear.axLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard the readings taken so far"
          }
        }
      }
    },
    "ar.sweep.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim the centre of the frame at the top of whatever blocks your view, then hold Sweep and turn on the spot. The sky is divided into thirty six sectors of ten degrees and each one fills as you reach it."
          }
        }
      }
    },
    "ar.sweep.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweeping your skyline is part of Sunlit Pro. It gives you the sunrise and sunset your own surroundings actually produce, and the periods when the sun is up but behind them."
          }
        }
      }
    },
    "ar.sweep.record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to sweep"
          }
        }
      }
    },
    "ar.sweep.record.axHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim the centre of the frame at the skyline, then hold this button and turn on the spot. One activation takes a single reading, which is how the sweep is done with VoiceOver running"
          }
        }
      }
    },
    "ar.sweep.record.axLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep the skyline"
          }
        }
      }
    },
    "ar.sweep.record.axLocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        }
      }
    },
    "ar.sweep.record.axUncalibrated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable until the compass is calibrated"
          }
        }
      }
    },
    "ar.sweep.recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweeping"
          }
        }
      }
    },
    "ar.sweep.replaces": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving replaces the skyline stored for this place."
