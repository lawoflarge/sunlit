          "stringUnit": {
            "state": "translated",
            "value": "Precisão da bússola, mais ou menos %1$@"
          }
        }
      }
    },
    "ar.accuracy.calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compass needs calibrating. Move the phone in a figure of eight, and stand clear of metal, magnets and car dashboards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kompass muss kalibriert werden. Das Telefon in einer Acht bewegen und Abstand zu Metall, Magneten und Armaturenbrettern halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boussole a besoin d’un calibrage. Décrivez un huit avec le téléphone, à l’écart du métal, des aimants et des tableaux de bord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bussola va calibrata. Muovi il telefono a forma di otto e stai lontano da metalli, magneti e cruscotti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La brújula necesita calibrarse. Mueve el móvil describiendo un ocho y aléjate de metales, imanes y salpicaderos de coche."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La brújula necesita calibrarse. Mueve el celular en forma de ocho y aléjate de metales, imanes y tableros de auto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kompas moet worden gekalibreerd. Beweeg de telefoon in een acht en blijf uit de buurt van metaal, magneten en dashboards."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas wymaga kalibracji. Zataczaj telefonem ósemkę z dala od metalu, magnesów i deski rozdzielczej samochodu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパスの調整が必要です。端末で8の字を描くように動かし、金属、磁石、車のダッシュボードから離れてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bússola precisa de calibração. Mova o celular em forma de oito e fique longe de metal, ímãs e painéis de carro."
          }
        }
      }
    },
    "ar.accuracy.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The figure at the top of the frame is the heading accuracy the device reports. The positions themselves are computed, not measured, and are accurate to far better than the compass can be aimed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahl oben im Bild ist die Kompassgenauigkeit, die das Gerät meldet. Die Positionen selbst sind berechnet, nicht gemessen, und weit genauer, als sich der Kompass ausrichten lässt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre en haut du cadre est la précision de cap rapportée par l’appareil. Les positions, elles, sont calculées et non mesurées : leur exactitude dépasse de loin ce que la boussole permet de viser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore in alto nell'inquadratura è la precisione della direzione dichiarata dal dispositivo. Le posizioni invece sono calcolate, non misurate, e sono molto più precise di quanto la bussola possa essere puntata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra de la parte superior del encuadre es la precisión de rumbo que declara el dispositivo. Las posiciones se calculan, no se miden, y son mucho más precisas de lo que la brújula puede apuntar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra en la parte superior del cuadro es la precisión del rumbo que reporta el dispositivo. Las posiciones mismas se calculan, no se miden, y son mucho más precisas de lo que la brújula puede apuntar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het cijfer boven in beeld is de koersnauwkeurigheid die het toestel meldt. De posities zelf worden berekend, niet gemeten, en zijn veel nauwkeuriger dan het kompas gericht kan worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość u góry kadru to dokładność kursu podawana przez urządzenie. Same pozycje są obliczane, a nie mierzone, i są znacznie dokładniejsze, niż da się wycelować kompasem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部の数値は、端末が報告する方位精度です。位置そのものは実測ではなく計算値で、コンパスで狙える精度よりはるかに高い精度で求められています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número no alto do quadro é a precisão da bússola informada pelo dispositivo. As posições em si são calculadas, não medidas, e têm precisão muito melhor do que a mira da bússola consegue alcançar."
          }
        }
      }
    },
