    "places.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a name. The list holds every city above fifteen thousand people and needs no network. Accents are optional, so koln finds Köln."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Namen eintippen. Die Liste enthält jede Stadt über fünfzehntausend Einwohnern und braucht kein Netz. Akzente sind optional, koln findet also Köln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez un nom. La liste contient chaque ville de plus de quinze mille habitants et n’a besoin d’aucun réseau. Les accents sont facultatifs : orleans trouve Orléans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un nome. L'elenco contiene ogni città sopra i quindicimila abitanti e non ha bisogno della rete. Gli accenti sono facoltativi, quindi koln trova Köln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre. La lista contiene todas las ciudades de más de quince mil habitantes y no necesita red. Los acentos son opcionales, así que koln encuentra Köln."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre. La lista tiene todas las ciudades de más de quince mil personas y no necesita red. Los acentos son opcionales, así que cancun encuentra Cancún."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een naam. De lijst bevat elke stad boven vijftienduizend inwoners en heeft geen netwerk nodig. Accenten zijn optioneel, dus koln vindt Köln."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nazwę. Lista zawiera każde miasto powyżej piętnastu tysięcy mieszkańców i nie potrzebuje sieci. Znaki diakrytyczne są opcjonalne, więc lodz znajduje Łódź."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を入力してください。リストは人口1万5千人を超えるすべての都市を収録し、ネットワークは不要です。アクセントは省略できるので、koln で Köln が見つかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome. A lista tem todas as cidades acima de quinze mil pessoas e não precisa de rede. Os acentos são opcionais, então koln encontra Köln."
          }
        }
      }
    },
