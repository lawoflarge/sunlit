    "data.golden.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden is the sun between four degrees below and six degrees above the horizon. Blue is between six and four degrees below it. Neither is an hour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden ist die Sonne zwischen vier Grad unter und sechs Grad über dem Horizont. Blau ist sie zwischen sechs und vier Grad darunter. Keine von beiden dauert eine Stunde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure dorée, c’est le Soleil entre quatre degrés sous l’horizon et six degrés au-dessus. L’heure bleue, c’est entre six et quatre degrés sous l’horizon. Ni l’une ni l’autre ne dure une heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora d'oro è il Sole tra quattro gradi sotto e sei gradi sopra l'orizzonte. L'ora blu è tra sei e quattro gradi sotto. Nessuna delle due dura un'ora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora dorada es el sol entre cuatro grados por debajo y seis grados por encima del horizonte. La azul, entre seis y cuatro grados por debajo. Ninguna dura una hora."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La dorada es el sol entre cuatro grados bajo el horizonte y seis grados sobre él. La azul es entre seis y cuatro grados bajo él. Ninguna dura una hora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goud is de zon tussen vier graden onder en zes graden boven de horizon. Blauw is tussen zes en vier graden eronder. Geen van beide duurt een uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złota godzina to Słońce między czterema stopniami pod horyzontem a sześcioma nad nim. Niebieska to między sześcioma a czterema stopniami pod horyzontem. Żadna z nich nie trwa godziny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴールデンアワーは太陽が地平線の下4度から上6度にある間です。ブルーアワーは地平線の下6度から4度の間です。どちらも1時間ではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A dourada é o sol entre quatro graus abaixo e seis graus acima do horizonte. A azul é entre seis e quatro graus abaixo dele. Nenhuma das duas dura uma hora."
          }
        }
      }
    },
