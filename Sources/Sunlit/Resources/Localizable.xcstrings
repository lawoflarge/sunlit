    "date.gate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today at your current location is free forever, in all four views. Any other day is part of Sunlit Pro. The calendar stays open either way, so you can see what you would be looking at."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute am aktuellen Standort ist für immer gratis, in allen vier Ansichten. Jeder andere Tag gehört zu Sunlit Pro. Der Kalender bleibt so oder so offen, damit sichtbar ist, was zu sehen wäre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui à votre position actuelle est gratuit pour toujours, dans les quatre vues. Tout autre jour fait partie de Sunlit Pro. Le calendrier reste ouvert dans les deux cas, pour que vous voyiez ce que vous regarderiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nella tua posizione attuale è gratis per sempre, in tutte e quattro le viste. Qualsiasi altro giorno fa parte di Sunlit Pro. Il calendario resta comunque aperto, così puoi vedere che cosa avresti davanti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre, en las cuatro vistas. Cualquier otro día forma parte de Sunlit Pro. El calendario sigue abierto de todas formas, para que veas qué estarías mirando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu ubicación actual es gratis para siempre, en las cuatro vistas. Cualquier otro día es parte de Sunlit Pro. El calendario queda abierto de todos modos, para que veas lo que estarías viendo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je huidige locatie is voor altijd gratis, in alle vier de weergaven. Elke andere dag hoort bij Sunlit Pro. De kalender blijft hoe dan ook open, zodat je kunt zien waar je naar zou kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dzień w bieżącej lokalizacji jest darmowy na zawsze, we wszystkich czterech widokach. Każdy inny dzień jest częścią Sunlit Pro. Kalendarz i tak pozostaje otwarty, więc widzisz, na co byś patrzył."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の今日は、4つのビューすべてで永久に無料です。それ以外の日は Sunlit Pro の機能です。どちらの場合もカレンダーは開いたままなので、何が見られるかを確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na sua localização atual é grátis para sempre, nas quatro visualizações. Qualquer outro dia faz parte do Sunlit Pro. O calendário continua aberto de qualquer forma, para você ver o que estaria vendo."
          }
        }
      }
    },
