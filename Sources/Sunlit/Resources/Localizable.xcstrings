    "map.polarDay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays above the horizon all day here, so there is no sunrise or sunset to point at."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag über dem Horizont, es gibt also keinen Sonnenaufgang und keinen Sonnenuntergang, auf den zu zeigen wäre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste au-dessus de l’horizon toute la journée ici : il n’y a donc ni lever ni coucher à pointer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta sopra l'orizzonte per tutto il giorno, quindi non c'è un'alba o un tramonto da indicare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene sobre el horizonte todo el día, así que no hay salida ni puesta a la que apuntar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene sobre el horizonte todo el día aquí, así que no hay salida ni puesta que señalar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag boven de horizon, dus er is geen zonsopgang of zonsondergang om naar te wijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez cały dzień nad horyzontem, więc nie ma wschodu ani zachodu, na które można wskazać."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽が一日中地平線より上にあるため、指し示す日の出も日の入りもありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica acima do horizonte o dia todo aqui, então não há nascer nem pôr do sol para apontar."
          }
        }
      }
    },
    "map.polarNight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun stays below the horizon all day here, so there is no sunrise or sunset to point at."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne bleibt hier den ganzen Tag unter dem Horizont, es gibt also keinen Sonnenaufgang und keinen Sonnenuntergang, auf den zu zeigen wäre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil reste sous l’horizon toute la journée ici : il n’y a donc ni lever ni coucher à pointer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui il Sole resta sotto l'orizzonte per tutto il giorno, quindi non c'è un'alba o un tramonto da indicare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el sol se mantiene bajo el horizonte todo el día, así que no hay salida ni puesta a la que apuntar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol se mantiene bajo el horizonte todo el día aquí, así que no hay salida ni puesta que señalar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon blijft hier de hele dag onder de horizon, dus er is geen zonsopgang of zonsondergang om naar te wijzen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest tu przez cały dzień pod horyzontem, więc nie ma wschodu ani zachodu, na które można wskazać."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは太陽が一日中地平線より下にあるため、指し示す日の出も日の入りもありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol fica abaixo do horizonte o dia todo aqui, então não há nascer nem pôr do sol para apontar."
          }
        }
      }
    },
