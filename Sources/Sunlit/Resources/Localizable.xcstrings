            "state": "translated",
            "value": "Hier is geen camera, dus de banen worden in plaats daarvan over de hemelkleur getekend. Al het andere op dit scherm werkt gewoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu aparatu, więc drogi rysowane są na kolorze nieba. Reszta tego ekranu działa normalnie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはカメラがないため、軌道は空の色の上に描かれます。この画面の他の機能はすべて動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há câmera aqui, então as trajetórias são desenhadas sobre a cor do céu. Todo o resto desta tela continua funcionando."
          }
        }
      }
    },
    "ar.camera.undetermined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit can draw these paths over your real view. The image stays on your device and is never recorded or sent anywhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit kann diese Bahnen über die reale Sicht zeichnen. Das Bild bleibt auf dem Gerät und wird nie aufgezeichnet oder irgendwohin gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit peut tracer ces trajectoires sur votre vue réelle. L’image reste sur votre appareil, elle n’est jamais enregistrée ni envoyée nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit può disegnare questi percorsi sulla tua visuale reale. L'immagine resta sul tuo dispositivo e non viene mai registrata né inviata da nessuna parte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit puede dibujar estas trayectorias sobre tu vista real. La imagen se queda en tu dispositivo y nunca se graba ni se envía a ninguna parte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit puede dibujar estas trayectorias sobre tu vista real. La imagen se queda en tu dispositivo y nunca se graba ni se envía a ningún lado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit kan deze banen over je echte beeld tekenen. Het beeld blijft op je toestel en wordt nooit opgenomen of ergens naartoe gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit może rysować te drogi na żywym obrazie. Obraz zostaje na urządzeniu, nie jest nagrywany ani nigdzie wysyłany."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit はこれらの軌道を実際の視界に重ねて描けます。映像は端末内に留まり、記録も送信も一切されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunlit pode desenhar essas trajetórias sobre a sua vista real. A imagem fica no seu dispositivo e nunca é gravada nem enviada para lugar nenhum."
          }
        }
      }
    },
