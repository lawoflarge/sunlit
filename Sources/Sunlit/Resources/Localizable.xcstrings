    "map.locationRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit has no access to your position, so it cannot put the pin there. You can grant it in Settings. Choosing a place by hand instead is part of Sunlit Pro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit hat keinen Zugriff auf die Position und kann die Markierung daher nicht dorthin setzen. Der Zugriff lässt sich in den Einstellungen erteilen. Einen Ort stattdessen von Hand zu wählen gehört zu Sunlit Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit n’a pas accès à votre position : il ne peut donc pas y placer le repère. Vous pouvez l’autoriser dans Réglages. Choisir un lieu à la main fait partie de Sunlit Pro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit non ha accesso alla tua posizione, quindi non può metterci il segnaposto. Puoi concederlo in Impostazioni. Scegliere invece un luogo a mano fa parte di Sunlit Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit no tiene acceso a tu posición, así que no puede poner ahí el marcador. Puedes concederlo en Ajustes. Elegir un lugar a mano forma parte de Sunlit Pro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit no tiene acceso a tu posición, así que no puede poner ahí el pin. Puedes concederlo en Configuración. Elegir un lugar a mano es parte de Sunlit Pro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit heeft geen toegang tot je positie en kan de speld daar dus niet neerzetten. Je kunt die toegang geven in Instellingen. Zelf een plaats kiezen hoort bij Sunlit Pro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit nie ma dostępu do twojej pozycji, więc nie może tam postawić pinezki. Możesz go przyznać w Ustawieniach. Wybranie miejsca ręcznie jest częścią Sunlit Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunlit は位置情報にアクセスできないため、そこにピンを置けません。設定で許可できます。代わりに手で地点を選ぶことは Sunlit Pro の機能です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunlit não tem acesso à sua posição, então não pode colocar o marcador ali. Você pode conceder o acesso nos Ajustes. Escolher um local à mão faz parte do Sunlit Pro."
          }
        }
      }
    },
    "map.locked.moon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon's rise and set directions are part of Sunlit Pro. They are drawn faintly above so you can see what they add."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Richtungen für Mondaufgang und Monduntergang gehören zu Sunlit Pro. Sie sind oben blass gezeichnet, damit erkennbar ist, was sie ergänzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les directions de lever et de coucher de la Lune font partie de Sunlit Pro. Elles sont tracées en pâle ci-dessus pour que vous voyiez ce qu’elles apportent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le direzioni di sorgere e tramonto della Luna fanno parte di Sunlit Pro. Sopra sono disegnate in modo tenue, così puoi vedere che cosa aggiungono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de salida y puesta de la luna forman parte de Sunlit Pro. Arriba se dibujan tenues para que veas qué aportan."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de salida y de puesta de la luna son parte de Sunlit Pro. Se dibujan tenues arriba para que veas lo que aportan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De richtingen waarin de maan opkomt en ondergaat horen bij Sunlit Pro. Ze zijn hierboven vaag getekend, zodat je ziet wat ze toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierunki wschodu i zachodu Księżyca są częścią Sunlit Pro. Powyżej rysowane są słabo, aby było widać, co wnoszą."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の出と月の入りの方向は Sunlit Pro の機能です。何が加わるか分かるよう、上に淡く描いてあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As direções do nascer e do pôr da lua fazem parte do Sunlit Pro. Elas estão desenhadas de leve acima, para você ver o que acrescentam."
          }
        }
      }
    },
    "map.locked.place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scouting a place other than where you are is part of Sunlit Pro. The pin you tapped is marked on the map."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen anderen Ort als den eigenen zu erkunden gehört zu Sunlit Pro. Die angetippte Markierung ist auf der Karte eingezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérer un lieu autre que celui où vous êtes fait partie de Sunlit Pro. Le repère que vous avez touché est marqué sur la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplorare un luogo diverso da dove ti trovi fa parte di Sunlit Pro. Il segnaposto che hai toccato è segnato sulla mappa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorar un lugar distinto de donde estás forma parte de Sunlit Pro. El marcador que has tocado está señalado en el mapa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorar un lugar distinto de donde estás es parte de Sunlit Pro. El pin que tocaste queda marcado en el mapa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere plaats verkennen dan waar je bent hoort bij Sunlit Pro. De speld waarop je tikte staat op de kaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądanie miejsca innego niż twoje jest częścią Sunlit Pro. Dotknięta pinezka jest zaznaczona na mapie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地以外の場所を下見することは Sunlit Pro の機能です。タップしたピンは地図上に示してあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorar um local diferente de onde você está faz parte do Sunlit Pro. O marcador que você tocou está indicado no mapa."
          }
        }
      }
    },
    "map.map.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to move the pin here. The figures below give every direction in degrees."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um die Markierung hierher zu setzen. Die Werte darunter geben jede Richtung in Grad an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour déplacer le repère ici. Les valeurs ci-dessous donnent chaque direction en degrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per spostare qui il segnaposto. I valori qui sotto danno ogni direzione in gradi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa dos veces para mover aquí el marcador. Las cifras de abajo dan todas las direcciones en grados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para mover el pin aquí. Las cifras de abajo dan cada dirección en grados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbeltik om de speld hierheen te verplaatsen. De cijfers hieronder geven elke richting in graden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dwukrotnie, aby przenieść tu pinezkę. Wartości poniżej podają każdy kierunek w stopniach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでここにピンを移動します。下の数値はすべての方向を度で示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para mover o marcador para cá. Os valores abaixo dão todas as direções em graus."
          }
        }
      }
    },
