    "data.eclipse.moonBelowHorizon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon is below the horizon here at maximum, so this eclipse happens while it is out of sight from this place. The contact times are the same everywhere on Earth; only whether you can see them changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond steht hier im Maximum unter dem Horizont, diese Finsternis läuft also ab, während er von diesem Ort aus nicht zu sehen ist. Die Kontaktzeiten sind überall auf der Erde gleich, es ändert sich nur, ob man sie sehen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune est sous l’horizon ici au maximum : cette éclipse se produit donc hors de vue depuis ce lieu. Les heures de contact sont les mêmes partout sur Terre, seule change la possibilité de les voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo qui la Luna è sotto l'orizzonte, quindi questa eclissi avviene mentre è fuori dalla vista da questo luogo. Gli orari dei contatti sono gli stessi ovunque sulla Terra: cambia solo se puoi vederli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí la luna está bajo el horizonte en el máximo, así que este eclipse ocurre mientras queda fuera de la vista desde este lugar. Las horas de contacto son las mismas en toda la Tierra; solo cambia si puedes verlas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna está bajo el horizonte aquí en el máximo, así que este eclipse ocurre mientras ella queda fuera de vista desde este lugar. Las horas de contacto son las mismas en toda la Tierra; solo cambia si puedes verlas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maan staat hier bij het maximum onder de horizon, dus deze verduistering vindt plaats terwijl ze vanaf deze plaats niet te zien is. De contacttijden zijn overal op aarde gelijk, alleen of je ze kunt zien verschilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Księżyc jest tu w maksimum pod horyzontem, więc to zaćmienie zachodzi, gdy nie widać go z tego miejsca. Czasy kontaktów są takie same na całej Ziemi, zmienia się tylko to, czy da się je zobaczyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは食甚のとき月が地平線の下にあるため、この食はこの地点から見えない間に起こります。接触時刻は地球上のどこでも同じで、変わるのは見えるかどうかだけです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua está abaixo do horizonte aqui no máximo, então este eclipse acontece fora de vista deste local. Os horários de contato são os mesmos em toda a Terra; só muda se você consegue vê-los."
          }
        }
      }
    },
