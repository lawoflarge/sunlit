    "store.result.unverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store could not verify this purchase, so nothing was unlocked. Try Restore purchase, and contact Apple if you were charged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte diesen Kauf nicht bestätigen, es wurde also nichts freigeschaltet. Bitte den Kauf wiederherstellen und Apple kontaktieren, falls der Betrag abgebucht wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas pu vérifier cet achat : rien n’a été déverrouillé. Essayez Restaurer l’achat, et contactez Apple si vous avez été débité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non ha potuto verificare questo acquisto, quindi non è stato sbloccato nulla. Prova con Ripristina l'acquisto e contatta Apple se ti è stato addebitato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no ha podido verificar esta compra, así que no se ha desbloqueado nada. Prueba con Restaurar la compra, y ponte en contacto con Apple si se te ha cobrado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no pudo verificar esta compra, así que no se desbloqueó nada. Prueba Restaurar compra, y contacta a Apple si te cobraron."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store kon deze aankoop niet verifiëren, dus er is niets ontgrendeld. Probeer Aankoop herstellen, en neem contact op met Apple als er is afgeschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie zdołał zweryfikować tego zakupu, więc nic nie zostało odblokowane. Spróbuj Przywróć zakup, a jeśli pobrano opłatę, skontaktuj się z Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store がこの購入を検証できなかったため、何も解除されていません。購入の復元をお試しのうえ、請求されていた場合は Apple にご連絡ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não conseguiu verificar esta compra, então nada foi desbloqueado. Tente Restaurar a compra e fale com a Apple se você foi cobrado."
          }
        }
      }
    },
