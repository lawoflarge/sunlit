    "map.shadow.levelGround": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact geometry on level ground. The map does not know what the shadow falls on, or what stands in its way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakte Geometrie auf ebenem Boden. Die Karte weiß nicht, worauf der Schatten fällt oder was ihm im Weg steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géométrie exacte sur terrain plat. La carte ne sait pas sur quoi tombe l’ombre, ni ce qui se trouve sur son chemin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometria esatta su terreno pianeggiante. La mappa non sa su che cosa cade l'ombra, né che cosa le sta davanti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometría exacta sobre terreno llano. El mapa no sabe sobre qué cae la sombra, ni qué se interpone en su camino."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometría exacta sobre terreno plano. El mapa no sabe sobre qué cae la sombra, ni qué se interpone en su camino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exacte meetkunde op vlakke grond. De kaart weet niet waarop de schaduw valt, of wat er in de weg staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładna geometria na płaskim terenie. Mapa nie wie, na co pada cień ani co stoi mu na drodze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平な地面での正確な幾何計算です。地図は影が何の上に落ちるか、何が行く手にあるかを知りません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometria exata em solo plano. O mapa não sabe sobre o que a sombra cai, nem o que está no caminho dela."
          }
        }
      }
    },
    "map.shadow.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun is below the horizon at this instant, so there is no shadow to draw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne steht in diesem Moment unter dem Horizont, es gibt also keinen Schatten zu zeichnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil est sous l’horizon à cet instant : il n’y a donc pas d’ombre à tracer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo istante il Sole è sotto l'orizzonte, quindi non c'è un'ombra da disegnare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol está bajo el horizonte en este instante, así que no hay sombra que dibujar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol está bajo el horizonte en este instante, así que no hay sombra que dibujar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon staat op dit moment onder de horizon, dus er is geen schaduw te tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce jest w tej chwili pod horyzontem, więc nie ma cienia do narysowania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この瞬間、太陽は地平線より下にあるため、描く影はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol está abaixo do horizonte neste instante, então não há sombra para desenhar."
          }
        }
      }
    },
