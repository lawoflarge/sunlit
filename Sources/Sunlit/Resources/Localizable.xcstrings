    "data.export.zoneExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time in both files is written for %@, with its offset from Universal Time attached. The spreadsheet is in English with ISO 8601 timestamps and a full stop as the decimal separator, so that anyone can open it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Uhrzeit in beiden Dateien ist für %1$@ geschrieben, mit ihrem Versatz zur Weltzeit dabei. Die Tabelle ist auf Englisch, mit Zeitstempeln nach ISO 8601 und einem Punkt als Dezimaltrennzeichen, damit sie überall zu öffnen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure des deux fichiers est écrite pour %1$@, avec son décalage par rapport au Temps universel. La feuille de calcul est en anglais, avec des horodatages ISO 8601 et un point comme séparateur décimal, afin que tout le monde puisse l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni orario nei due file è scritto per %1$@, con accanto lo scarto dal Tempo universale. Il foglio di calcolo è in inglese, con marche temporali ISO 8601 e il punto come separatore decimale, così chiunque può aprirlo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las horas de ambos archivos se escriben para %1$@, con su desfase respecto al Tiempo Universal. La hoja de cálculo está en inglés, con marcas de tiempo ISO 8601 y punto como separador decimal, para que cualquiera pueda abrirla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora de los dos archivos se escribe para %1$@, con su diferencia respecto al Tiempo Universal. La hoja de cálculo va en inglés, con marcas de tiempo ISO 8601 y punto como separador decimal, para que cualquiera pueda abrirla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tijd in beide bestanden is genoteerd voor %1$@, met de afwijking ten opzichte van de universele tijd erbij. De spreadsheet is in het Engels, met tijdstempels volgens ISO 8601 en een punt als decimaalteken, zodat iedereen hem kan openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie godziny w obu plikach zapisano dla strefy %1$@, wraz z jej przesunięciem względem czasu uniwersalnego. Arkusz jest po angielsku, ze znacznikami czasu ISO 8601 i kropką jako separatorem dziesiętnym, aby każdy mógł go otworzyć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のファイルの時刻はすべて %1$@ で書かれ、世界時からのオフセットが添えられます。表計算ファイルは誰でも開けるよう、英語、ISO 8601 のタイムスタンプ、小数点はピリオドで書き出されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os horários dos dois arquivos são escritos para %1$@, acompanhados do deslocamento em relação ao Tempo Universal. A planilha está em inglês, com marcas de tempo ISO 8601 e ponto como separador decimal, para que qualquer pessoa consiga abri-la."
          }
        }
      }
    },
