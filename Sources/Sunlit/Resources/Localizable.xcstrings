    "data.moon.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, illumination and distance at local noon. Rise and set account for the moon's parallax, which makes it sit almost a degree lower than it would seen from the centre of the earth, so moonrise falls later than a flat calculation gives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, Beleuchtung und Entfernung zum Ortsmittag. Aufgang und Untergang berücksichtigen die Parallaxe des Mondes, die ihn fast ein Grad tiefer stehen lässt als vom Erdmittelpunkt aus gesehen, der Mondaufgang fällt daher später als bei einer einfachen Rechnung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase, fraction éclairée et distance au midi local. Le lever et le coucher tiennent compte de la parallaxe de la Lune, qui la place près d’un degré plus bas que vue depuis le centre de la Terre : le lever de la Lune tombe donc plus tard qu’avec un calcul sans parallaxe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, illuminazione e distanza alle 12 locali. Il sorgere e il tramontare tengono conto della parallasse della Luna, che la fa stare quasi un grado più in basso di quanto apparirebbe dal centro della Terra, quindi il sorgere della Luna cade più tardi di quanto risulti da un calcolo che la trascura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, iluminación y distancia al mediodía local. La salida y la puesta tienen en cuenta la paralaje de la luna, que la sitúa casi un grado más baja de lo que se vería desde el centro de la Tierra, así que la salida de la luna cae más tarde de lo que da un cálculo plano."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, iluminación y distancia al mediodía local. La salida y la puesta consideran la paralaje de la luna, que la sitúa casi un grado más abajo de lo que se vería desde el centro de la Tierra, así que la salida de la luna cae más tarde que en un cálculo plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, verlichting en afstand op de lokale middag. Opkomst en ondergang houden rekening met de parallax van de maan, die haar bijna een graad lager zet dan vanuit het middelpunt van de aarde gezien, zodat de maansopkomst later valt dan een vlakke berekening geeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Faza, oświetlenie i odległość w południe lokalne. Wschód i zachód uwzględniają paralaksę Księżyca, która obniża go o prawie stopień względem widoku ze środka Ziemi, więc wschód Księżyca wypada później, niż daje uproszczony rachunek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月相、輝面比、距離は現地正午の値です。月の出と月の入りは月の視差を織り込んでいます。視差は月を、地球の中心から見た場合より1度近く低い位置に置くため、月の出は単純な計算より遅くなります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase, iluminação e distância no meio-dia local. O nascer e o pôr levam em conta a paralaxe da lua, que a deixa quase um grau mais baixa do que ela estaria vista do centro da Terra, então o nascer da lua cai mais tarde do que num cálculo que a ignora."
          }
        }
      }
    },
