        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koersnauwkeurigheid, plus of min %1$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładność kursu, plus minus %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
