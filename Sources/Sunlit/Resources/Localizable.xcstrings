    "map.shadow.clamped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow runs further than the drawn line, which stops at %@. The length above is the whole of it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schatten reicht weiter als die gezeichnete Linie, die bei %1$@ endet. Die Länge oben ist der ganze Schatten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ombre va plus loin que la ligne tracée, qui s’arrête à %1$@. La longueur ci-dessus est la totalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ombra si estende oltre la linea disegnata, che si ferma a %1$@. La lunghezza qui sopra è quella completa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sombra llega más lejos que la línea dibujada, que se detiene en %1$@. La longitud de arriba es la total."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La sombra llega más lejos que la línea dibujada, que termina en %1$@. La longitud de arriba es la total."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schaduw loopt verder dan de getekende lijn, die stopt bij %1$@. De lengte hierboven is de hele schaduw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cień sięga dalej niż narysowana linia, która kończy się na %1$@. Długość powyżej to jego całość."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影は描かれた線より遠くまで伸びます。線は %1$@ で止まります。上の長さが影の全長です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sombra vai além da linha desenhada, que para em %1$@. O comprimento acima é o total dela."
          }
        }
      }
    },
