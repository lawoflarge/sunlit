    "data.model.clearSky": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UV index and irradiance are clear sky models, not measurements. They assume a cloudless atmosphere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UV-Index und Einstrahlung sind Klarhimmelmodelle, keine Messwerte. Sie setzen einen wolkenlosen Himmel voraus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice UV et l’irradiance sont des modèles de ciel clair, pas des mesures. Ils supposent une atmosphère sans nuage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indice UV e l'irradianza sono modelli di cielo sereno, non misure. Presuppongono un'atmosfera senza nuvole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice UV y la irradiancia son modelos de cielo despejado, no medidas. Suponen una atmósfera sin nubes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice UV y la irradiancia son modelos de cielo despejado, no mediciones. Suponen una atmósfera sin nubes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UV-index en instraling zijn modellen voor een heldere hemel, geen metingen. Ze gaan uit van een wolkenloze atmosfeer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks UV i irradiancja to modele czystego nieba, a nie pomiary. Zakładają atmosferę bez chmur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UVインデックスと日射量は実測値ではなく晴天モデルです。雲のない大気を前提にしています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O índice UV e a irradiância são modelos de céu limpo, não medições. Eles supõem uma atmosfera sem nuvens."
          }
        }
      }
    },
