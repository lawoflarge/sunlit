    "data.eclipse.magnitudeCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the sun's diameter the moon covers at maximum, as a share of that diameter. It passes one when the moon's disc is the larger of the two."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel vom Sonnendurchmesser der Mond im Maximum bedeckt, als Anteil dieses Durchmessers. Der Wert übersteigt eins, wenn die Mondscheibe die größere der beiden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part du diamètre du Soleil que la Lune couvre au maximum, rapportée à ce diamètre. Elle dépasse un quand le disque lunaire est le plus grand des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanta parte del diametro del Sole la Luna copre al massimo, come frazione di quel diametro. Supera uno quando il disco lunare è il più grande dei due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto del diámetro del sol cubre la luna en el máximo, como fracción de ese diámetro. Pasa de uno cuando el disco de la luna es el mayor de los dos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto del diámetro del sol cubre la luna en el máximo, como fracción de ese diámetro. Pasa de uno cuando el disco de la luna es el mayor de los dos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel van de zonsdiameter de maan bij het maximum bedekt, als deel van die diameter. Het komt boven één uit wanneer de maanschijf de grootste van de twee is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaką część średnicy Słońca zakrywa Księżyc w maksimum, wyrażona ułamkiem tej średnicy. Przekracza jeden, gdy tarcza Księżyca jest większa z tych dwóch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食甚時に月が覆う太陽の直径の割合を、その直径に対する比で表します。月の円盤のほうが大きいときは1を超えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto do diâmetro do sol a lua cobre no máximo, como fração desse diâmetro. Passa de um quando o disco da lua é o maior dos dois."
          }
        }
      }
    },
