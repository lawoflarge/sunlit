    "data.terrain.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared against the skyline you swept here, not against a flat horizon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verglichen mit dem hier aufgenommenen Horizontprofil, nicht mit einem flachen Horizont."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparé à la ligne d’horizon que vous avez balayée ici, pas à un horizon plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontato con il profilo che hai scansionato qui, non con un orizzonte piatto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con el perfil que has barrido aquí, no con un horizonte plano."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con el perfil del horizonte que barriste aquí, no con un horizonte plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeleken met het horizonprofiel dat je hier hebt gescand, niet met een vlakke horizon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównane z linią horyzontu zeskanowaną tutaj, a nie z płaskim horyzontem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平坦な地平線ではなく、ここで走査した稜線と比べています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado com o perfil que você varreu aqui, não com um horizonte plano."
          }
        }
      }
    },
