    "settings.horizon.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No skyline has been swept at %@, so Sunlit assumes a flat horizon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %1$@ wurde kein Horizontprofil aufgenommen, Sunlit nimmt daher einen flachen Horizont an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ligne d’horizon n’a été balayée à %1$@ : Sunlit suppose donc un horizon plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A %1$@ non è stato scansionato nessun profilo, quindi Sunlit assume un orizzonte piatto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha barrido ningún perfil en %1$@, así que Sunlit supone un horizonte plano."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha barrido ningún perfil del horizonte en %1$@, así que Sunlit supone un horizonte plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %1$@ is geen horizonprofiel gescand, dus Sunlit gaat uit van een vlakke horizon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miejscu %1$@ nie zeskanowano linii horyzontu, więc Sunlit przyjmuje płaski horyzont."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ では稜線を走査していないため、Sunlit は平坦な地平線を仮定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum perfil foi varrido em %1$@, então o Sunlit assume um horizonte plano."
          }
        }
      }
    },
