    "data.moon.alwaysDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moon stays below the horizon all day here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mond bleibt hier den ganzen Tag unter dem Horizont."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Lune reste sous l’horizon toute la journée ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui la Luna resta sotto l'orizzonte per tutto il giorno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí la luna se mantiene bajo el horizonte todo el día."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La luna se mantiene bajo el horizonte todo el día aquí."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De maan blijft hier de hele dag onder de horizon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Księżyc jest tu przez całą dobę pod horyzontem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは月がこの日ずっと地平線より下にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lua fica abaixo do horizonte o dia todo aqui."
          }
        }
