          "stringUnit": {
            "state": "translated",
            "value": "Il centro galattico, il piano galattico e una vera finestra di visibilità che dice che cosa la limita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico, el plano galáctico y una ventana de visibilidad real que dice qué la está limitando."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro galáctico, el plano galáctico, y una ventana de visibilidad real que nombra qué la limita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het galactisch centrum, het galactisch vlak, en een echt zichtbaarheidsvenster dat benoemt wat het beperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum Galaktyki, płaszczyzna Galaktyki i prawdziwe okno widoczności, które nazywa swoje ograniczenie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀河中心、銀河面、そして何が制約かを示す実際の観測時間帯。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O centro galáctico, o plano galáctico e uma janela real de visibilidade que diz o que a está limitando."
          }
        }
      }
    },
