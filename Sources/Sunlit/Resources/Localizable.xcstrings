    "data.twilight.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Civil at six degrees, nautical at twelve, astronomical at eighteen degrees below the horizon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bürgerlich bei sechs Grad, nautisch bei zwölf, astronomisch bei achtzehn Grad unter dem Horizont."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Civil à six degrés, nautique à douze, astronomique à dix-huit degrés sous l’horizon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Civile a sei gradi, nautico a dodici, astronomico a diciotto gradi sotto l'orizzonte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Civil a seis grados, náutico a doce y astronómico a dieciocho grados por debajo del horizonte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Civil a seis grados, náutico a doce, astronómico a dieciocho grados bajo el horizonte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Burgerlijk op zes graden, nautisch op twaalf, astronomisch op achttien graden onder de horizon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cywilny przy sześciu stopniach, żeglarski przy dwunastu, astronomiczny przy osiemnastu stopniach pod horyzontem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常用薄明は地平線下6度、航海薄明は12度、天文薄明は18度までです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Civil a seis graus, náutico a doze, astronômico a dezoito graus abaixo do horizonte."
          }
        }
      }
    },
    "data.twilight.civil.neverDark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun does not sink six degrees below the horizon on this date, so civil twilight lasts all night."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne sinkt an diesem Tag nicht sechs Grad unter den Horizont, die bürgerliche Dämmerung dauert also die ganze Nacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne descend pas à six degrés sous l’horizon à cette date : le crépuscule civil dure donc toute la nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa data il Sole non scende sei gradi sotto l'orizzonte, quindi il crepuscolo civile dura tutta la notte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja seis grados por debajo del horizonte en esta fecha, así que el crepúsculo civil dura toda la noche."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El sol no baja seis grados bajo el horizonte en esta fecha, así que el crepúsculo civil dura toda la noche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon zakt op deze datum niet zes graden onder de horizon, dus de burgerlijke schemering duurt de hele nacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej dacie Słońce nie schodzi sześć stopni pod horyzont, więc zmierzch cywilny trwa całą noc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付、太陽は地平線より6度下まで沈まないため、常用薄明が一晩中続きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sol não desce seis graus abaixo do horizonte nesta data, então o crepúsculo civil dura a noite toda."
          }
        }
      }
