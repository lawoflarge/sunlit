    "map.tapHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to move the pin. Press and hold to drop one and centre on it. Every other view follows the pin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Karte tippen, um die Markierung zu versetzen. Gedrückt halten, um eine zu setzen und darauf zu zentrieren. Jede andere Ansicht folgt der Markierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte pour déplacer le repère. Appuyez longuement pour en déposer un et centrer dessus. Toutes les autres vues suivent le repère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la mappa per spostare il segnaposto. Tieni premuto per metterne uno e centrarlo. Tutte le altre viste seguono il segnaposto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el mapa para mover el marcador. Mantén pulsado para soltar uno y centrarte en él. Todas las demás vistas siguen al marcador."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el mapa para mover el pin. Mantén presionado para colocar uno y centrar en él. Las demás vistas siguen el pin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de kaart om de speld te verplaatsen. Houd ingedrukt om er een te plaatsen en erop te centreren. Elke andere weergave volgt de speld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij mapy, aby przenieść pinezkę. Przytrzymaj, aby postawić nową i wyśrodkować na niej. Wszystkie pozostałe widoki podążają za pinezką."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップするとピンが動きます。長押しでピンを置き、そこを中心にします。他のビューはすべてピンに従います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no mapa para mover o marcador. Mantenha pressionado para soltar um e centralizar nele. Todas as outras visualizações seguem o marcador."
          }
        }
      }
    },
