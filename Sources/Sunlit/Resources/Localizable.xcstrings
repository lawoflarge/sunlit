    "date.zone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days run on the clock of %@, not on your own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage laufen auf der Uhr von %1$@, nicht auf der eigenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours suivent l’horloge de %1$@, pas la vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni seguono l'orologio di %1$@, non il tuo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días van con el reloj de %1$@, no con el tuyo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días corren en el reloj de %1$@, no en el tuyo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen lopen op de klok van %1$@, niet op die van jou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doby liczy zegar miejsca %1$@, a nie twój własny."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は %1$@ の時計で区切ります。あなた自身の時計ではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias seguem o relógio de %1$@, não o seu."
