        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op %1$@, geen maansondergang op deze dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wschodzi %1$@, tego dnia bez zachodu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の出 %1$@、この日は月の入りなし"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasce %1$@, sem pôr da lua neste dia"
