    "paywall.capability.terrain.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep your skyline with the camera, then get sunrise and sunset over that skyline and every period the sun is behind it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Horizontprofil mit der Kamera aufnehmen, dann Sonnenaufgang und Sonnenuntergang über diesem Profil und jeden Zeitraum, in dem die Sonne dahinter steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez votre ligne d’horizon avec l’appareil photo, puis obtenez le lever et le coucher au-dessus de cette ligne, et chaque période où le Soleil est derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il tuo profilo con la fotocamera, poi ottieni alba e tramonto su quel profilo e ogni periodo in cui il Sole ci sta dietro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre tu perfil con la cámara y obtén la salida y la puesta del sol sobre ese perfil y todos los periodos en que el sol queda detrás."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre tu horizonte con la cámara y obtén la salida y la puesta del sol sobre ese horizonte, y cada periodo en que el sol está detrás de él."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan je horizonprofiel met de camera, en krijg dan zonsopgang en zonsondergang over dat profiel en elke periode waarin de zon erachter zit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj linię horyzontu aparatem, a dostaniesz wschód i zachód Słońca nad nią oraz każdy okres, gdy Słońce jest za nią."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラで稜線を走査すると、その稜線での日の出と日の入り、太陽が稜線の裏にあるすべての時間帯が分かります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Varra o seu perfil com a câmera e tenha o nascer e o pôr do sol sobre esse perfil e todos os períodos em que o sol fica atrás dele."
          }
        }
      }
    },
