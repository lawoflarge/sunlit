    "data.eclipse.obscurationCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraction of the sun's area covered at maximum. Never larger than the magnitude, because a bite taken out of the edge of a disc removes less of its area than of its width."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteil der Sonnenfläche, der im Maximum bedeckt ist. Nie größer als die Magnitude, denn ein Biss aus dem Rand einer Scheibe nimmt weniger von ihrer Fläche als von ihrer Breite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraction de la surface du Soleil couverte au maximum. Jamais supérieure à la magnitude, car une entaille au bord d’un disque en retire moins de surface que de largeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frazione dell'area del Sole coperta al massimo. Mai maggiore della magnitudine, perché un morso tolto dal bordo di un disco ne sottrae meno area che larghezza."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fracción del área del sol cubierta en el máximo. Nunca mayor que la magnitud, porque un mordisco en el borde de un disco quita menos área que anchura."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fracción del área del sol cubierta en el máximo. Nunca es mayor que la magnitud, porque un mordisco en el borde de un disco quita menos de su área que de su ancho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel van het zonsoppervlak dat bij het maximum bedekt is. Nooit groter dan de magnitude, want een hap uit de rand van een schijf neemt minder van het oppervlak weg dan van de breedte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułamek powierzchni Słońca zakryty w maksimum. Nigdy nie jest większy od wielkości zaćmienia, bo wycinek zabrany z brzegu tarczy odbiera mniej jej powierzchni niż szerokości."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食甚時に覆われる太陽の面積の割合です。円盤の縁が欠けるとき、失われる面積の割合は幅の割合より小さいため、この値が食分を上回ることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fração da área do sol coberta no máximo. Nunca maior que a magnitude, porque uma mordida na borda de um disco tira menos da área dele do que da largura."
          }
        }
      }
    },
