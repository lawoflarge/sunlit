    "accuracy.uncertainty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heading accuracy, plus or minus %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompassgenauigkeit, plus oder minus %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
